{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
-%}

<section class="section cart-page color-{{ section_scheme }}">
  <div class="container flow">
    <header class="cart-page__header cluster">
      <h1>{{ 'sections.cart.title' | t }}</h1>
      {%- unless cart.empty? -%}
        <span>{{ 'sections.cart.item_count' | t: count: cart.item_count }}</span>
      {%- endunless -%}
    </header>

    {%- if cart.empty? -%}
      <div class="cart-empty flow">
        <p>{{ 'sections.cart.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">
          {{- 'sections.cart.continue_shopping' | t -}}
        </a>
      </div>
    {%- else -%}
      <form class="cart-form" action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-items" role="list">
          {%- for item in cart.items -%}
            <article class="cart-item" role="listitem">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image != blank -%}
                  {% render 'responsive-image',
                    image: item.image,
                    sizes: '(min-width: 750px) 160px, 96px',
                    widths: '96, 160, 240, 320',
                    image_class: 'cart-item__image',
                    alt: item.image.alt
                  %}
                {%- endif -%}
              </a>

              <div class="cart-item__details flow">
                {%- if section.settings.show_vendor and item.product.vendor != blank -%}
                  <p class="cart-item__vendor eyebrow">{{ item.product.vendor | escape }}</p>
                {%- endif -%}

                <h2 class="cart-item__title">
                  <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                </h2>

                {%- unless item.product.has_only_default_variant -%}
                  <dl class="cart-item__options">
                    {%- for option in item.options_with_values -%}
                      <div>
                        <dt>{{ option.name | escape }}</dt>
                        <dd>{{ option.value | escape }}</dd>
                      </div>
                    {%- endfor -%}
                  </dl>
                {%- endunless -%}

                {%- if item.selling_plan_allocation != nil -%}
                  <p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                {%- endif -%}

                {%- for property in item.properties -%}
                  {%- assign property_first_character = property.first | slice: 0 -%}
                  {%- if property.last != blank and property_first_character != '_' -%}
                    <p>
                      <span>{{ property.first | escape }}:</span>
                      {%- if property.last contains '/uploads/' -%}
                        <a href="{{ property.last | escape }}" target="_blank" rel="noopener">
                          {{- property.last | split: '/' | last | escape -}}
                          <span class="visually-hidden"> {{ 'general.accessibility.opens_in_new_window' | t }}</span>
                        </a>
                      {%- else -%}
                        {{- property.last | escape -}}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- endfor -%}

                {%- if item.line_level_discount_allocations.size > 0 -%}
                  <ul class="cart-item__discounts unstyled-list" aria-label="{{ 'sections.cart.discount' | t }}">
                    {%- for discount in item.line_level_discount_allocations -%}
                      <li>{% render 'icon', name: 'check', size: 16 %} {{ discount.discount_application.title | escape }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="cart-item__price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                    <s>{{ item.original_line_price | money }}</s>
                    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
                  {%- endif -%}
                  <span>{{ item.final_line_price | money }}</span>

                  {%- if item.variant.unit_price_measurement -%}
                    <small class="price__unit">
                      <span class="visually-hidden">{{ 'products.product.unit_price' | t }}</span>
                      {{ item.variant.unit_price | money }}
                      <span aria-hidden="true">/</span>
                      {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                        {{- item.variant.unit_price_measurement.reference_value -}}
                      {%- endif -%}
                      {{- item.variant.unit_price_measurement.reference_unit -}}
                    </small>
                  {%- endif -%}
                </div>
              </div>

              <div class="cart-item__controls">
                {%- liquid
                  assign quantity_min = item.variant.quantity_rule.min | default: 1
                  assign quantity_step = item.variant.quantity_rule.increment | default: 1
                  assign quantity_max = item.variant.quantity_rule.max
                -%}
                <label for="CartQuantity-{{ forloop.index }}">{{ 'sections.cart.quantity' | t }}</label>
                {%- comment -%}
                  Esta pagina funciona sin JavaScript: el formulario se envia con el boton
                  "Update cart". Los botones del stepper editan el campo (como escribir en
                  el), no envian nada, y se ocultan con .no-js para no dejar controles
                  muertos cuando el JavaScript no llega.
                {%- endcomment -%}
                <div class="quantity-stepper cart-item__stepper" data-quantity-stepper>
                  <button
                    class="quantity-stepper__button"
                    type="button"
                    name="minus"
                    aria-label="{{ 'sections.cart.decrease_quantity' | t: title: item.title | escape }}"
                    aria-controls="CartQuantity-{{ forloop.index }}"
                    data-quantity-button="decrease"
                    {% if item.quantity <= quantity_min %}disabled{% endif %}
                  >
                    {% render 'icon', name: 'minus', size: 16 %}
                  </button>
                  <input
                    id="CartQuantity-{{ forloop.index }}"
                    class="quantity-stepper__input"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="{{ quantity_min }}"
                    step="{{ quantity_step }}"
                    {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %}
                    inputmode="numeric"
                    data-quantity-input
                  >
                  <button
                    class="quantity-stepper__button"
                    type="button"
                    name="plus"
                    aria-label="{{ 'sections.cart.increase_quantity' | t: title: item.title | escape }}"
                    aria-controls="CartQuantity-{{ forloop.index }}"
                    data-quantity-button="increase"
                    {% if quantity_max != blank and item.quantity >= quantity_max %}disabled{% endif %}
                  >
                    {% render 'icon', name: 'plus', size: 16 %}
                  </button>
                </div>
                <a href="{{ item.url_to_remove }}" aria-label="{{ 'sections.cart.remove_item' | t: title: item.title | escape }}">
                  {{- 'sections.cart.remove' | t -}}
                </a>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <footer class="cart-page__footer">
          {%- if settings.show_cart_note -%}
            <div class="cart-note">
              <label for="CartNote">{{ 'sections.cart.note' | t }}</label>
              <textarea id="CartNote" name="note" placeholder="{{ 'sections.cart.note_placeholder' | t | escape }}">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-summary flow">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart-summary__discounts unstyled-list" aria-label="{{ 'sections.cart.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>
                    <span>{% render 'icon', name: 'check', size: 16 %} {{ discount.title | escape }}</span>
                    <span>-{{ discount.total_allocated_amount | money }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="cart-summary__subtotal">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money_with_currency }}</strong>
            </div>

            <p class="cart-summary__taxes">
              {%- if cart.taxes_included -%}
                {{- 'sections.cart.taxes_included' | t -}}
              {%- else -%}
                {{- 'sections.cart.taxes_and_shipping_at_checkout' | t -}}
              {%- endif -%}
            </p>

            <div class="cart-summary__actions">
              <button class="button button--secondary" type="submit" name="update">
                {{- 'sections.cart.update' | t -}}
              </button>
              <button class="button" type="submit" name="checkout">
                {{- 'sections.cart.checkout' | t -}}
              </button>
            </div>
          </div>
        </footer>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart_items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.all.show_vendor.label",
      "default": false
    }
  ]
}
{% endschema %}
