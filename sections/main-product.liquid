{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
-%}

<section class="section product-main color-{{ section_scheme }}" data-section-id="{{ section.id }}">
  <div class="container product-main__layout product-main__layout--{{ section.settings.media_layout }}">
    <div class="product-gallery" aria-label="{{ 'products.product.media_gallery' | t }}">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          {%- assign media_alt = media.alt | default: product.title -%}
          <figure
            class="product-gallery__item"
            data-product-media-id="{{ media.id }}"
            {% if media.id == selected_variant.featured_media.id %}data-selected{% endif %}
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {% render 'responsive-image',
                  image: media.preview_image,
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  prioritize: forloop.first,
                  image_class: 'product-gallery__image',
                  alt: media_alt
                %}
              {%- when 'video' or 'external_video' -%}
                {{ media | media_tag: image_size: '1200x', controls: true, class: 'product-gallery__media' }}
              {%- when 'model' -%}
                {{ media | media_tag: image_size: '1200x', toggleable: true, class: 'product-gallery__media' }}
            {%- endcase -%}
          </figure>
        {%- endfor -%}
      {%- else -%}
        <div class="product-gallery__placeholder" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    <variant-selects
      class="product-main__details"
      data-product-url="{{ product.url }}"
      data-add-to-cart-text="{{ 'products.product.add_to_cart' | t | escape }}"
      data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
      data-unavailable-text="{{ 'products.product.unavailable' | t | escape }}"
      data-available-status="{{ 'products.product.variant_available' | t | escape }}"
      data-sold-out-status="{{ 'products.product.variant_sold_out' | t | escape }}"
    >
      <div class="product-main__info flow">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product-main__vendor eyebrow" {{ block.shopify_attributes }}>
                  {{- product.vendor | escape -}}
                </p>
              {%- endif -%}

            {%- when 'title' -%}
              <header class="product-main__header" {{ block.shopify_attributes }}>
                <h1 class="product-main__title">{{ product.title | escape }}</h1>
              </header>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'price',
                  product: product,
                  variant: selected_variant,
                  use_variant: true,
                  show_badges: true,
                  show_unit_price: true,
                  show_taxes: true,
                  price_class: 'product-main__price'
                %}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker flow" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__group" role="radiogroup">
                      <legend class="variant-picker__legend">
                        {{- option.name | escape -}}:
                        <span data-selected-option="{{ option.position }}">{{ option.selected_value | escape }}</span>
                      </legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          {%- assign option_id = 'option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                          <input
                            class="variant-picker__input visually-hidden"
                            type="radio"
                            id="{{ option_id }}"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-position="{{ option.position }}"
                            {% if value.selected %}checked{% endif %}
                            aria-disabled="{% if value.available %}false{% else %}true{% endif %}"
                            {% unless value.available %}disabled{% endunless %}
                          >
                          <label class="variant-picker__label" for="{{ option_id }}">
                            <span>{{ value | escape }}</span>
                            <span data-unavailable-label{% if value.available %} hidden{% endif %}>
                              <span aria-hidden="true">&times;</span>
                              <span class="visually-hidden">{{ 'products.product.option_unavailable' | t }}</span>
                            </span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="product-form__quantity" {{ block.shopify_attributes }}>
                <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                <input
                  id="Quantity-{{ section.id }}"
                  type="number"
                  name="quantity"
                  form="{{ product_form_id }}"
                  value="{{ selected_variant.quantity_rule.min | default: 1 }}"
                  min="{{ selected_variant.quantity_rule.min | default: 1 }}"
                  step="{{ selected_variant.quantity_rule.increment | default: 1 }}"
                  {% if selected_variant.quantity_rule.max != blank %}max="{{ selected_variant.quantity_rule.max }}"{% endif %}
                  inputmode="numeric"
                  data-quantity-input
                >
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product-form" {{ block.shopify_attributes }}>
                {%- form 'product', product,
                  id: product_form_id,
                  class: 'product-form__form',
                  data-cart-add-form: ''
                -%}
                  <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>
                  <button
                    class="button button--full product-form__submit"
                    type="submit"
                    name="add"
                    data-add-to-cart
                    {% unless selected_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-to-cart-text>
                      {%- if selected_variant.available -%}
                        {{- 'products.product.add_to_cart' | t -}}
                      {%- else -%}
                        {{- 'products.product.sold_out' | t -}}
                      {%- endif -%}
                    </span>
                    <span class="button__spinner" data-loading-icon hidden>
                      {% render 'icon', name: 'spinner', size: 18 %}
                    </span>
                  </button>

                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product-form__dynamic-checkout">
                      {{ form | payment_button }}
                    </div>
                  {%- endif -%}

                  <p class="form-message" role="alert" data-product-form-error hidden></p>
                {%- endform -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product-main__description rte" {{ block.shopify_attributes }}>
                  {{- product.description -}}
                </div>
              {%- endif -%}

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-variant-status></p>
      </div>

      <script type="application/json" data-variant-json>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "title": {{ variant.title | json }},
              "available": {{ variant.available | json }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price | money | json }},
              "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
              "unit_price": {% if variant.unit_price_measurement %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
              "unit_reference_value": {% if variant.unit_price_measurement %}{{ variant.unit_price_measurement.reference_value | json }}{% else %}null{% endif %},
              "unit_reference_unit": {% if variant.unit_price_measurement %}{{ variant.unit_price_measurement.reference_unit | json }}{% else %}null{% endif %},
              "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},
              "quantity_min": {{ variant.quantity_rule.min | default: 1 | json }},
              "quantity_increment": {{ variant.quantity_rule.increment | default: 1 | json }},
              "quantity_max": {% if variant.quantity_rule.max != blank %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    </variant-selects>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Media layout",
      "options": [
        { "value": "stack", "label": "Stack" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
