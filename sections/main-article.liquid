{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign title_id = 'ArticleTitle-' | append: section.id
  assign article_word_count = article.content | strip_html | split: ' ' | size
  assign reading_time = article_word_count | divided_by: 200
  assign reading_remainder = article_word_count | modulo: 200
  if reading_remainder > 0
    assign reading_time = reading_time | plus: 1
  endif
  assign reading_time = reading_time | at_least: 1
  assign article_category = article.tags.first
  if article_category == blank
    assign article_category = 'blogs.blog.editorial' | t
  endif
  assign article_alt = article.image.alt | default: article.title
  assign article_caption = section.settings.hero_caption | default: article.image.alt
  assign featured_product_count = 0
  for block in section.blocks
    if block.type == 'featured_product' and block.settings.product != blank
      assign featured_product_count = featured_product_count | plus: 1
    endif
  endfor
-%}

<article class="section main-article color-{{ section_scheme }}" aria-labelledby="{{ title_id }}">
  <div class="container flow">
    <header class="main-article__header flow">
      <p class="eyebrow">{{ article_category | escape }}</p>
      <h1 id="{{ title_id }}" class="main-article__title">{{ article.title | escape }}</h1>
      <p class="main-article__meta">
        {%- if section.settings.show_author and article.author != blank -%}
          {{- 'blogs.article.by_author' | t: author: article.author | escape -}}
          <span aria-hidden="true"> / </span>
        {%- endif -%}
        {{- article.published_at | time_tag: format: 'date' -}}
        <span aria-hidden="true"> / </span>
        {{- 'blogs.article.reading_time' | t: count: reading_time -}}
      </p>
    </header>

    {%- if article.image != blank -%}
      <figure class="main-article__hero">
        <div class="main-article__hero-media">
          {% render 'responsive-image',
            image: article.image,
            sizes: '(min-width: 62rem) min(100vw - 10rem, 1120px), 100vw',
            widths: '550, 750, 960, 1200, 1600, 2000',
            image_class: 'main-article__hero-image',
            alt: article_alt,
            prioritize: true
          %}
        </div>
        {%- if article_caption != blank -%}
          <figcaption>{{ article_caption | escape }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="main-article__reading rte">{{ article.content }}</div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'pull_quote' and block.settings.quote != blank -%}
        <figure class="main-article__pull-quote" {{ block.shopify_attributes }}>
          <blockquote>{{ block.settings.quote }}</blockquote>
          {%- if block.settings.attribution != blank -%}
            <figcaption>{{ block.settings.attribution | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    {%- endfor -%}

    {%- if featured_product_count > 0 -%}
      <section class="main-article__objects" aria-labelledby="FeaturedObjects-{{ section.id }}">
        <h2 id="FeaturedObjects-{{ section.id }}" class="eyebrow">{{ 'blogs.article.featured_objects' | t }}</h2>
        <ul class="main-article__product-grid unstyled-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'featured_product' and block.settings.product != blank -%}
              <li {{ block.shopify_attributes }}>
                {% render 'product-card',
                  card_product: block.settings.product,
                  show_secondary_image: true,
                  show_vendor: false,
                  show_quick_add: false
                %}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    <nav class="main-article__navigation" aria-label="{{ 'blogs.article.navigation' | t }}">
      {%- if blog.previous_article -%}
        <a class="main-article__navigation-link" href="{{ blog.previous_article.url }}" rel="prev">
          <span class="eyebrow">{{ 'blogs.article.previous' | t }}</span>
          <strong>{{ blog.previous_article.title | escape }}</strong>
        </a>
      {%- endif -%}
      {%- if blog.next_article -%}
        <a class="main-article__navigation-link main-article__navigation-link--next" href="{{ blog.next_article.url }}" rel="next">
          <span class="eyebrow">{{ 'blogs.article.next' | t }}</span>
          <strong>{{ blog.next_article.title | escape }}</strong>
        </a>
      {%- endif -%}
    </nav>

    {%- if blog.comments_enabled? -%}
      <section class="main-article__comments" id="Comments-{{ section.id }}" aria-labelledby="CommentsTitle-{{ section.id }}">
        {%- paginate article.comments by section.settings.comments_per_page -%}
          <header class="main-article__comments-header">
            <p class="eyebrow">{{ 'blogs.comments.eyebrow' | t }}</p>
            <h2 id="CommentsTitle-{{ section.id }}">
              {{- 'blogs.comments.count' | t: count: article.comments_count -}}
            </h2>
          </header>

          {%- if article.comments.size > 0 -%}
            <ol class="comment-list unstyled-list">
              {%- for comment in article.comments -%}
                <li id="Comment-{{ comment.id }}" class="comment">
                  <div class="comment__content">{{ comment.content | escape | newline_to_br }}</div>
                  <p class="comment__meta">
                    <strong>{{ comment.author | escape }}</strong>
                    <span aria-hidden="true"> / </span>
                    {{ comment.created_at | time_tag: format: 'date' }}
                  </p>
                </li>
              {%- endfor -%}
            </ol>
          {%- else -%}
            <p>{{ 'blogs.comments.none' | t }}</p>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="{{ 'blogs.comments.pagination' | t }}">
              {%- if paginate.previous -%}
                <a class="pagination__link" href="{{ paginate.previous.url }}#Comments-{{ section.id }}">{{ 'general.pagination.previous' | t }}</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="pagination__link" href="{{ part.url }}#Comments-{{ section.id }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="pagination__link" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="pagination__ellipsis">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a class="pagination__link" href="{{ paginate.next.url }}#Comments-{{ section.id }}">{{ 'general.pagination.next' | t }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

          <div class="comment-form-wrap flow">
            <h3>{{ 'blogs.comments.form_title' | t }}</h3>
            {%- form 'new_comment', article, class: 'comment-form flow' -%}
              {%- if form.posted_successfully? -%}
                <p class="form-message form-message--success" role="status" tabindex="-1">
                  {%- if blog.moderated? -%}
                    {{- 'blogs.comments.success_moderated' | t -}}
                  {%- else -%}
                    {{- 'blogs.comments.success' | t -}}
                  {%- endif -%}
                </p>
              {%- endif -%}
              {%- if form.errors -%}
                <div id="CommentErrors-{{ section.id }}" class="form-message form-message--error" role="alert" tabindex="-1">
                  <p>{{ 'blogs.comments.error_heading' | t }}</p>
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="comment-form__grid">
                <div class="form-field">
                  <label for="CommentAuthor-{{ section.id }}">{{ 'blogs.comments.name' | t }}</label>
                  <input
                    id="CommentAuthor-{{ section.id }}"
                    type="text"
                    name="comment[author]"
                    value="{{ form.author | default: customer.name | escape }}"
                    autocomplete="name"
                    aria-required="true"
                    required
                  >
                </div>
                <div class="form-field">
                  <label for="CommentEmail-{{ section.id }}">{{ 'blogs.comments.email' | t }}</label>
                  <input
                    id="CommentEmail-{{ section.id }}"
                    type="email"
                    name="comment[email]"
                    value="{{ form.email | default: customer.email | escape }}"
                    autocomplete="email"
                    autocapitalize="off"
                    spellcheck="false"
                    aria-required="true"
                    aria-invalid="{% if form.errors contains 'email' %}true{% else %}false{% endif %}"
                    {% if form.errors contains 'email' %}aria-describedby="CommentErrors-{{ section.id }}"{% endif %}
                    required
                  >
                </div>
              </div>
              <div class="form-field">
                <label for="CommentBody-{{ section.id }}">{{ 'blogs.comments.message' | t }}</label>
                <textarea id="CommentBody-{{ section.id }}" name="comment[body]" aria-required="true" required>{{ form.body | escape }}</textarea>
              </div>
              <button class="button" type="submit">{{ 'blogs.comments.submit' | t }}</button>
            {%- endform -%}
          </div>
        {%- endpaginate -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.main_article.settings.show_author.label",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_caption",
      "label": "t:sections.main_article.settings.hero_caption.label"
    },
    {
      "type": "range",
      "id": "comments_per_page",
      "min": 5,
      "max": 25,
      "step": 5,
      "label": "t:sections.main_article.settings.comments_per_page.label",
      "default": 10
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "pull_quote",
      "name": "t:sections.main_article.blocks.pull_quote.name",
      "limit": 2,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "quote",
          "label": "t:sections.all.quote.label",
          "default": "The material is never silent."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "t:sections.all.attribution.label"
        }
      ]
    },
    {
      "type": "featured_product",
      "name": "t:sections.main_article.blocks.featured_product.name",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.all.product.label"
        }
      ]
    }
  ]
}
{% endschema %}
