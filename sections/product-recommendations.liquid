{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign recommendations_heading = section.settings.heading
  if recommendations_heading == blank
    if section.settings.intent == 'complementary'
      assign recommendations_heading = 'products.recommendations.complementary_heading' | t
    else
      assign recommendations_heading = 'products.recommendations.related_heading' | t
    endif
  endif
  assign recommendations_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.products_to_show | append: '&intent=' | append: section.settings.intent
-%}

<product-recommendations
  class="product-recommendations color-{{ section_scheme }}"
  data-url="{{ recommendations_url | escape }}"
  data-intent="{{ section.settings.intent }}"
  aria-busy="{% if recommendations.performed? %}false{% else %}true{% endif %}"
  {% if recommendations.performed? and recommendations.products_count == 0 %}hidden{% endif %}
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <section class="section product-recommendations__content" aria-labelledby="RecommendationsTitle-{{ section.id }}" data-recommendations-content>
      <div class="container flow">
        <header class="product-recommendations__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="RecommendationsTitle-{{ section.id }}">{{ recommendations_heading | escape }}</h2>
        </header>

        <ul
          class="product-recommendations__grid unstyled-list"
          data-columns="{{ section.settings.columns_desktop }}"
        >
          {%- for recommendation in recommendations.products -%}
            <li>
              {% render 'product-card',
                card_product: recommendation,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_quick_add: section.settings.show_quick_add
              %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation intent",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Continue the study"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
