{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign title_id = 'PasswordTitle-' | append: section.id
  assign newsletter_email_id = 'PasswordEmail-' | append: section.id
  assign modal_id = 'PasswordAccess-' | append: section.id
  assign password_input_id = 'StorefrontPassword-' | append: section.id
  assign image_alt = section.settings.image_alt
  if image_alt == blank
    assign image_alt = 'password.image_alt' | t
  endif
-%}

<password-modal>
  <section class="main-password color-{{ section_scheme }}" aria-labelledby="{{ title_id }}">
    <div class="main-password__media">
      {%- if section.settings.image != blank -%}
        {% render 'responsive-image',
          image: section.settings.image,
          sizes: '(min-width: 62rem) 56vw, 100vw',
          widths: '390, 550, 750, 960, 1200, 1600',
          image_class: 'main-password__image',
          alt: image_alt,
          prioritize: true
        %}
      {%- else -%}
        <span class="main-password__media-placeholder" aria-hidden="true"></span>
      {%- endif -%}
    </div>

    <div class="main-password__content">
      <div class="main-password__access">
        <button
          class="main-password__access-trigger js-only"
          type="button"
          aria-controls="{{ modal_id }}"
          aria-expanded="false"
          data-password-open
        >
          {{- 'password.access.open' | t -}}
        </button>
        <a class="main-password__access-trigger no-js-only" href="#{{ modal_id }}">
          {{- 'password.access.open' | t -}}
        </a>
      </div>

      <div class="main-password__copy flow">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 id="{{ title_id }}" class="main-password__title">{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="rte lede">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if shop.password_message != blank -%}
          <div class="main-password__merchant-message rte">{{ shop.password_message }}</div>
        {%- endif -%}

        {%- form 'customer', class: 'password-newsletter flow' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,password page">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" tabindex="-1">
              {{- 'password.newsletter.success' | t -}}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <div id="PasswordNewsletterErrors-{{ section.id }}" class="form-message form-message--error" role="alert" tabindex="-1">
              <p>{{ 'password.newsletter.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="form-field">
            <label for="{{ newsletter_email_id }}">{{ 'password.newsletter.email' | t }}</label>
            <input
              id="{{ newsletter_email_id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              aria-required="true"
              aria-invalid="{% if form.errors contains 'email' %}true{% else %}false{% endif %}"
              {% if form.errors contains 'email' %}aria-describedby="PasswordNewsletterErrors-{{ section.id }}"{% endif %}
              required
            >
          </div>
          <button class="button button--full" type="submit">{{ 'password.newsletter.submit' | t }}</button>
          <p class="password-newsletter__privacy">{{ 'password.newsletter.privacy' | t }}</p>
        {%- endform -%}

        {%- if section.settings.opening_note != blank -%}
          <div class="main-password__opening-note">
            <p class="eyebrow">{{ 'password.opening_label' | t }}</p>
            <p>{{ section.settings.opening_note | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="password-modal__overlay" data-password-overlay>
      <section
        id="{{ modal_id }}"
        class="password-modal__panel color-{{ section_scheme }}"
        role="dialog"
        aria-modal="false"
        aria-hidden="false"
        aria-labelledby="PasswordModalTitle-{{ section.id }}"
        tabindex="-1"
        data-password-panel
      >
        <button class="icon-button password-modal__close js-only" type="button" aria-label="{{ 'general.accessibility.close' | t }}" data-password-close>
          {% render 'icon', name: 'close', size: 22 %}
        </button>
        <div class="password-modal__content flow">
          <p class="eyebrow">{{ 'password.access.eyebrow' | t }}</p>
          <h2 id="PasswordModalTitle-{{ section.id }}">{{ 'password.access.title' | t }}</h2>
          <p>{{ 'password.access.instructions' | t }}</p>

          {%- form 'storefront_password', class: 'storefront-password-form flow' -%}
            {%- if form.errors -%}
              <div id="StorefrontPasswordErrors-{{ section.id }}" class="form-message form-message--error" role="alert" tabindex="-1" data-password-error>
                <p>{{ 'password.access.error' | t }}</p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="form-field">
              <label for="{{ password_input_id }}">{{ 'password.access.label' | t }}</label>
              <input
                id="{{ password_input_id }}"
                type="password"
                name="password"
                autocomplete="current-password"
                aria-required="true"
                aria-invalid="{% if form.errors %}true{% else %}false{% endif %}"
                {% if form.errors %}aria-describedby="StorefrontPasswordErrors-{{ section.id }}"{% endif %}
                required
              >
            </div>
            <button class="button button--full" type="submit">{{ 'password.access.submit' | t }}</button>
          {%- endform -%}
        </div>
      </section>
    </div>
  </section>
</password-modal>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main_password.settings.image.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.all.image_alt.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label",
      "default": "Private collection / New edition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "The next study opens quietly."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.main_password.settings.text.label",
      "default": "<p>Join the private list for first access, studio notes and a preview of the making process.</p>"
    },
    {
      "type": "text",
      "id": "opening_note",
      "label": "t:sections.main_password.settings.opening_note.label",
      "info": "t:sections.main_password.settings.opening_note.info",
      "default": "Wool, fired earth and softened leather."
    }
  ]
}
{% endschema %}
