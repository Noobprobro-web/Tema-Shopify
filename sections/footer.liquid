{%- liquid
  assign color_scheme_id = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-2'
  assign current_year = 'now' | date: '%Y'
  assign shop_name = shop.name | escape
  assign has_social_links = false
  if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank
    assign has_social_links = true
  endif
-%}

<footer class="site-footer color-{{ color_scheme_id }}" data-section-id="{{ section.id }}">
  <div class="container site-footer__grid">
    <div class="site-footer__brand flow">
      <a class="site-footer__title h2" href="{{ routes.root_url }}">{{ shop_name }}</a>
      {%- if section.settings.show_description and shop.description != blank -%}
        <p>{{ shop.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="site-footer__newsletter">
        <p class="eyebrow">{{ 'newsletter.eyebrow' | t }}</p>
        <h2 class="site-footer__newsletter-title h3">
          {%- if section.settings.newsletter_heading != blank -%}
            {{- section.settings.newsletter_heading | escape -}}
          {%- else -%}
            {{- 'newsletter.heading' | t -}}
          {%- endif -%}
        </h2>
        <p>
          {%- if section.settings.newsletter_text != blank -%}
            {{- section.settings.newsletter_text | escape -}}
          {%- else -%}
            {{- 'newsletter.copy' | t -}}
          {%- endif -%}
        </p>

        {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field">
            <label class="visually-hidden" for="FooterNewsletterEmail">
              {{- 'newsletter.email_label' | t -}}
            </label>
            <input
              id="FooterNewsletterEmail"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              autocapitalize="off"
              autocorrect="off"
              placeholder="{{ 'newsletter.email_placeholder' | t | escape }}"
              aria-required="true"
              {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}
              required
            >
            <button class="button newsletter-form__submit" type="submit">
              {{- 'newsletter.submit' | t -}}
            </button>
          </div>

          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">
              {{- 'newsletter.success' | t -}}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <div id="FooterNewsletterError" class="form-message form-message--error" role="alert">
              <p>{{ 'newsletter.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      <nav class="site-footer__nav" aria-label="{{ 'general.navigation.footer' | t }}">
        <ul class="site-footer__menu unstyled-list" role="list">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if section.settings.show_social and has_social_links -%}
      <nav class="site-footer__social" aria-label="{{ 'general.social.follow_us' | t }}">
        <p class="eyebrow">{{ 'general.social.follow_us' | t }}</p>
        <ul class="social-links unstyled-list" role="list">
          {%- if settings.social_instagram_link != blank -%}
            <li><a href="{{ settings.social_instagram_link | escape }}">{{ 'general.social.instagram' | t }}</a></li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li><a href="{{ settings.social_facebook_link | escape }}">{{ 'general.social.facebook' | t }}</a></li>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <li><a href="{{ settings.social_pinterest_link | escape }}">{{ 'general.social.pinterest' | t }}</a></li>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <li><a href="{{ settings.social_tiktok_link | escape }}">{{ 'general.social.tiktok' | t }}</a></li>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <li><a href="{{ settings.social_youtube_link | escape }}">{{ 'general.social.youtube' | t }}</a></li>
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  {%- if shop.enabled_payment_types.size > 0 -%}
    <div class="container site-footer__utilities">
      <div class="site-footer__payments">
        <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
        <ul class="site-footer__payment-list unstyled-list" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="site-footer__payment-item">{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  <div class="container site-footer__bottom">
    <div class="site-footer__legal">
      <small>{{ 'sections.footer.copyright' | t: year: current_year, shop: shop_name }}</small>
      <small class="site-footer__powered-by">{{ powered_by_link }}</small>
    </div>
    <div class="site-footer__follow">
      {{ shop | login_button: action: 'follow' }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "div",
  "class": "section-footer",
  "limit": 1,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.footer.settings.menu.label",
      "default": "footer"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.footer.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.footer.settings.show_description.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter.label",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "t:sections.footer.settings.newsletter_text.label"
    }
  ]
}
{% endschema %}
