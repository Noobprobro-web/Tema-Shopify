{{ 'section-standard-a.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign feature_collection = section.settings.collection
  assign product_limit = section.settings.products_to_show | default: 4
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign title_id = 'FeaturedCollectionTitle-' | append: section.id
  assign region_label = feature_collection.title
  if region_label == blank
    assign region_label = 'sections.featured_collection.region_label' | t
  endif

  # Column counts feed both the grid and the image sizes, so the browser asks for a
  # candidate as wide as the real box. From 48rem the grid never exceeds three columns.
  assign columns_mobile = section.settings.columns_mobile | default: 2 | plus: 0
  assign columns_desktop = section.settings.columns_desktop | default: 4 | plus: 0
  assign columns_tablet = columns_desktop | at_most: 3

  # Only the first section on the page loads its images eagerly.
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign has_products = false
  if feature_collection != blank and feature_collection.products_count > 0
    assign has_products = true
  endif
  assign show_view_all = false
  if section.settings.show_view_all and feature_collection != blank
    assign show_view_all = true
  endif
  assign grid_is_single = false
  if has_products and feature_collection.products_count == 1
    assign grid_is_single = true
  endif

  # A lone product sits in a grid capped at 28rem (448px) with a single track at every
  # breakpoint (see .std-grid--single in section-standard-a.css), so the card is as wide as the
  # cap, not a share of the viewport divided by the column settings.
  assign card_sizes = blank
  if grid_is_single
    capture card_sizes
      render 'card-sizes', columns_mobile: 1, columns_tablet: 1, columns_desktop: 1, max_width: 448
    endcapture
  endif
-%}

{%- if feature_collection == blank or has_products or request.design_mode -%}
  <section
    class="section std-section featured-collection color-{{ section_scheme }}"
    style="--std-padding-top: {{ section.settings.padding_top }}px; --std-padding-bottom: {{ section.settings.padding_bottom }}px; --std-columns-mobile: {{ columns_mobile }}; --std-columns-tablet: {{ columns_tablet }}; --std-columns-desktop: {{ columns_desktop }};"
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ title_id }}"
    {% else %}
      aria-label="{{ region_label | escape }}"
    {% endif %}
  >
    <div class="std-section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank or show_view_all -%}
        <header class="std-section__header">
          <div class="std-section__title-group">
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <{{ heading_tag }} id="{{ title_id }}" class="std-section__heading">
                {{- section.settings.heading | escape -}}
              </{{ heading_tag }}>
            {%- endif -%}
          </div>
          {%- if show_view_all -%}
            <a
              class="std-section__link"
              href="{{ feature_collection.url }}"
              aria-label="{{ 'sections.featured_collection.view_all_label' | t: title: feature_collection.title | escape_once }}"
            >
              <span class="std-section__link-text">{{ 'sections.featured_collection.view_all' | t }}</span>
              {% render 'icon', name: 'arrow', size: 18 %}
            </a>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if feature_collection == blank -%}
        {%- if request.design_mode -%}
          <p class="std-section__note">{{ 'sections.featured_collection.choose_collection' | t }}</p>
        {%- endif -%}
        <ul class="std-grid" aria-hidden="true">
          {%- for placeholder_index in (1..columns_desktop) -%}
            <li class="product-grid__item">
              <div class="product-card">
                <div class="product-card__media">
                  {{- 'product-' | append: placeholder_index | placeholder_svg_tag: 'homepage-placeholder' -}}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif has_products -%}
        <ul class="std-grid{% if grid_is_single %} std-grid--single{% endif %}">
          {%- for card_product in feature_collection.products limit: product_limit -%}
            <li class="product-grid__item">
              {% render 'product-card',
                card_product: card_product,
                eager_image: is_first_section,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_quick_add: section.settings.show_quick_add,
                columns_mobile: columns_mobile,
                columns_tablet: columns_tablet,
                columns_desktop: columns_desktop,
                sizes: card_sizes
              %}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="std-section__note">{{ 'sections.featured_collection.empty_collection' | t }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.featured_collection.settings.heading_tag.label",
      "info": "t:sections.featured_collection.settings.heading_tag.info",
      "options": [
        { "value": "h2", "label": "t:sections.featured_collection.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.featured_collection.settings.heading_tag.options__2.label" }
      ],
      "default": "h2"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.all.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.all.products_to_show.label",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.layout_header.content"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.all.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.all.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.all.columns_desktop.options__3.label" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.featured_collection.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.featured_collection.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.featured_collection.settings.columns_mobile.options__2.label" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.all.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.all.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.all.show_quick_add.label",
      "info": "t:sections.all.show_quick_add.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.appearance_header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_product.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_product.settings.padding_bottom.label",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name"
    }
  ]
}
{% endschema %}
