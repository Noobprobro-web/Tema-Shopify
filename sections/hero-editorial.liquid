{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign hero_image = section.settings.image_desktop | default: section.settings.image_mobile
  assign hero_alt = section.settings.image_alt | default: section.settings.heading
-%}

<section
  class="section hero-editorial hero-editorial--{{ section.settings.layout_split }} color-{{ section_scheme }}"
  {% if section.settings.heading != blank %}
    aria-labelledby="HeroEditorialTitle-{{ section.id }}"
  {% else %}
    aria-label="{{ 'sections.homepage.hero.region_label' | t }}"
  {% endif %}
>
  <div class="hero-editorial__inner">
    <div class="hero-editorial__intro flow">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 id="HeroEditorialTitle-{{ section.id }}" class="hero-editorial__heading">
          {{- section.settings.heading | escape -}}
        </h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="hero-editorial__subheading rte">
          {{- section.settings.subheading -}}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-editorial__media">
      {%- if hero_image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 47.99rem)"
              srcset="
                {{ section.settings.image_mobile | image_url: width: 390 }} 390w,
                {{ section.settings.image_mobile | image_url: width: 550 }} 550w,
                {{ section.settings.image_mobile | image_url: width: 750 }} 750w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {% render 'responsive-image',
            image: hero_image,
            sizes: '(min-width: 62rem) 60vw, 100vw',
            widths: '550, 750, 960, 1200, 1600, 2000',
            prioritize: true,
            image_class: 'hero-editorial__image',
            alt: hero_alt
          %}
        </picture>
      {%- else -%}
        <div class="hero-editorial__placeholder" aria-hidden="true">
          {{- 'lifestyle-1' | placeholder_svg_tag: 'homepage-placeholder' -}}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_primary_label != blank or section.settings.button_secondary_label != blank -%}
      <div class="hero-editorial__actions">
        {%- if section.settings.button_primary_label != blank -%}
          <a
            class="button hero-editorial__button"
            href="{{ section.settings.button_primary_url | default: routes.all_products_collection_url }}"
          >
            <span>{{ section.settings.button_primary_label | escape }}</span>
            {% render 'icon', name: 'arrow', size: 18 %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_secondary_label != blank -%}
          <a
            class="button button--secondary hero-editorial__button"
            href="{{ section.settings.button_secondary_url | default: routes.root_url }}"
          >
            <span>{{ section.settings.button_secondary_label | escape }}</span>
            {% render 'icon', name: 'arrow', size: 18 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial split hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alternative text",
      "info": "Describe the image for customers using screen readers."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE EDIT / COUTURE 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Autumn / Winter 26"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>A study in quiet movement. Sculptural layers and tactile materials, made in small series.</p>"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary button label",
      "default": "Discover the collection"
    },
    {
      "type": "url",
      "id": "button_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "Explore lookbook"
    },
    {
      "type": "url",
      "id": "button_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "layout_split",
      "label": "Desktop layout",
      "options": [
        { "value": "image_first", "label": "Image first (60 / 40)" },
        { "value": "text_first", "label": "Text first (40 / 60)" }
      ],
      "default": "image_first"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Editorial split hero"
    }
  ]
}
{% endschema %}
