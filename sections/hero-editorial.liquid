{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign layout_mode = section.settings.layout_mode | default: 'split'

  # AF-10 (AUDIT-FINAL-001): en modo split la imagen ocupa 60/65/50 % del ancho desde 62rem
  # (base.css, .hero-editorial--split). Con sizes 100vw el navegador bajaba casi el doble.
  assign hero_sizes = '100vw'
  if layout_mode == 'split'
    case section.settings.split_ratio
      when '65_35'
        assign hero_sizes = '(min-width: 62rem) 65vw, 100vw'
      when '50_50'
        assign hero_sizes = '(min-width: 62rem) 50vw, 100vw'
      else
        assign hero_sizes = '(min-width: 62rem) 60vw, 100vw'
    endcase
  endif
  assign hero_image = section.settings.image_desktop | default: section.settings.image_mobile
  assign hero_video = section.settings.video
  assign video_poster = section.settings.video_poster | default: hero_image | default: hero_video.preview_image
  assign hero_alt = section.settings.image_alt | default: section.settings.heading

  # The hero only claims the page h1 on the homepage. Every other template already
  # renders its own h1, so the automatic level drops to h2 there.
  assign heading_tag = section.settings.heading_tag
  if heading_tag == blank or heading_tag == 'auto'
    assign heading_tag = 'h2'
    if template.name == 'index'
      assign heading_tag = 'h1'
    endif
  endif

  assign uses_video = false
  if section.settings.media_type == 'video' and hero_video != blank and video_poster != blank
    assign uses_video = true
  endif

  # Native focal point of whichever asset actually renders.
  assign focal_image = hero_image
  if uses_video
    assign focal_image = video_poster
  endif
  assign hero_focal_point = focal_image.presentation.focal_point | default: 'center'

  # A button needs both a label and a destination. With no destination there is no
  # button at all, rather than a button that silently returns to the homepage.
  assign has_primary_button = false
  assign has_secondary_button = false
  if section.settings.button_primary_label != blank and section.settings.button_primary_url != blank
    assign has_primary_button = true
  endif
  if section.settings.button_secondary_label != blank and section.settings.button_secondary_url != blank
    assign has_secondary_button = true
  endif
-%}

<editorial-hero
  class="editorial-hero"
  data-enable-video-mobile="{{ section.settings.enable_video_mobile }}"
>
  <section
    class="section hero-editorial hero-editorial--{{ layout_mode }} hero-editorial--{{ section.settings.layout_split }} hero-editorial--split-{{ section.settings.split_ratio }} hero-editorial--x-{{ section.settings.content_position_x }} hero-editorial--y-{{ section.settings.content_position_y }} hero-editorial--align-{{ section.settings.text_alignment }} hero-editorial--overlay-{{ section.settings.overlay_style }} color-{{ section_scheme }}"
    style="--hero-height-desktop: {{ section.settings.height_desktop }}svh; --hero-height-mobile: {{ section.settings.height_mobile }}svh; --hero-content-width: {{ section.settings.content_width }}%; --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    {% if section.settings.heading != blank %}
      aria-labelledby="HeroEditorialTitle-{{ section.id }}"
    {% else %}
      aria-label="{{ 'sections.homepage.hero.region_label' | t }}"
    {% endif %}
  >
    <div class="hero-editorial__inner">
      <div class="hero-editorial__media" style="--hero-focal-point: {{ hero_focal_point }};">
        {%- if uses_video -%}
          <picture class="hero-editorial__poster">
            {%- if section.settings.image_mobile != blank -%}
              <source
                media="(max-width: 47.99rem)"
                srcset="
                  {{ section.settings.image_mobile | image_url: width: 390 }} 390w,
                  {{ section.settings.image_mobile | image_url: width: 550 }} 550w,
                  {{ section.settings.image_mobile | image_url: width: 750 }} 750w
                "
                sizes="100vw"
                width="{{ section.settings.image_mobile.width }}"
                height="{{ section.settings.image_mobile.height }}"
              >
            {%- endif -%}
            {% render 'responsive-image',
              image: video_poster,
              sizes: hero_sizes,
              widths: '550, 750, 960, 1200, 1600, 2000, 2400',
              prioritize: true,
              image_class: 'hero-editorial__image',
              alt: hero_alt
            %}
          </picture>
          <video
            class="hero-editorial__video"
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-editorial-hero-video
          >
            {%- for source in hero_video.sources -%}
              <source data-src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">
            {%- endfor -%}
          </video>
        {%- elsif hero_image != blank -%}
          <picture>
            {%- if section.settings.image_mobile != blank -%}
              <source
                media="(max-width: 47.99rem)"
                srcset="
                  {{ section.settings.image_mobile | image_url: width: 390 }} 390w,
                  {{ section.settings.image_mobile | image_url: width: 550 }} 550w,
                  {{ section.settings.image_mobile | image_url: width: 750 }} 750w
                "
                sizes="100vw"
                width="{{ section.settings.image_mobile.width }}"
                height="{{ section.settings.image_mobile.height }}"
              >
            {%- endif -%}
            {% render 'responsive-image',
              image: hero_image,
              sizes: hero_sizes,
              widths: '550, 750, 960, 1200, 1600, 2000, 2400',
              prioritize: true,
              image_class: 'hero-editorial__image',
              alt: hero_alt
            %}
          </picture>
        {%- else -%}
          <div class="hero-editorial__placeholder" aria-hidden="true">
            {{- 'lifestyle-1' | placeholder_svg_tag: 'homepage-placeholder' -}}
          </div>
        {%- endif -%}

        {%- comment -%}
          "Gradient behind the text only" (gradient_content) ya no oscurece la imagen entera: el velo se
          dibuja detras del bloque de texto y lo sigue a donde se coloque (4F-001). Antes era
          un degradado fijo desde la izquierda que no hacia lo que decia su etiqueta y
          dejaba el texto sin fondo en cuanto el contenido iba a la derecha.
        {%- endcomment -%}
        {%- if layout_mode == 'cinematic' and section.settings.overlay_style != 'none' and section.settings.overlay_style != 'gradient_content' -%}
          <span class="hero-editorial__overlay hero-editorial__overlay--{{ section.settings.overlay_style }}" aria-hidden="true"></span>
        {%- endif -%}
      </div>

      <div class="hero-editorial__content">
        <div class="hero-editorial__intro flow">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} id="HeroEditorialTitle-{{ section.id }}" class="hero-editorial__heading">
              {{- section.settings.heading | escape -}}
            </{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="hero-editorial__subheading rte">
              {{- section.settings.subheading -}}
            </div>
          {%- endif -%}
        </div>

        {%- if has_primary_button or has_secondary_button -%}
          <div class="hero-editorial__actions">
            {%- if has_primary_button -%}
              <a
                class="button hero-editorial__button"
                href="{{ section.settings.button_primary_url | escape }}"
              >
                <span>{{ section.settings.button_primary_label | escape }}</span>
                {% render 'icon', name: 'arrow', size: 18 %}
              </a>
            {%- endif -%}
            {%- if has_secondary_button -%}
              <a
                class="button button--secondary hero-editorial__button"
                href="{{ section.settings.button_secondary_url | escape }}"
              >
                <span>{{ section.settings.button_secondary_label | escape }}</span>
                {% render 'icon', name: 'arrow', size: 18 %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</editorial-hero>

{% schema %}
{
  "name": "t:sections.hero_editorial.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_mode",
      "label": "t:sections.hero_editorial.settings.layout_mode.label",
      "options": [
        { "value": "split", "label": "t:sections.hero_editorial.settings.layout_mode.options__1.label" },
        { "value": "cinematic", "label": "t:sections.hero_editorial.settings.layout_mode.options__2.label" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "split_ratio",
      "label": "t:sections.hero_editorial.settings.split_ratio.label",
      "options": [
        { "value": "60_40", "label": "t:sections.hero_editorial.settings.split_ratio.options__1.label" },
        { "value": "65_35", "label": "t:sections.hero_editorial.settings.split_ratio.options__2.label" },
        { "value": "50_50", "label": "t:sections.hero_editorial.settings.split_ratio.options__3.label" }
      ],
      "default": "60_40"
    },
    {
      "type": "select",
      "id": "layout_split",
      "label": "t:sections.hero_editorial.settings.layout_split.label",
      "options": [
        { "value": "image_first", "label": "t:sections.hero_editorial.settings.layout_split.options__1.label" },
        { "value": "text_first", "label": "t:sections.hero_editorial.settings.layout_split.options__2.label" }
      ],
      "default": "image_first"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.hero_editorial.settings.height_desktop.label",
      "default": 90
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.hero_editorial.settings.height_mobile.label",
      "default": 75
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.hero_editorial.settings.media_type.label",
      "options": [
        { "value": "image", "label": "t:sections.hero_editorial.settings.media_type.options__1.label" },
        { "value": "video", "label": "t:sections.hero_editorial.settings.media_type.options__2.label" }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.hero_editorial.settings.video.label",
      "info": "t:sections.hero_editorial.settings.video.info"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "t:sections.hero_editorial.settings.video_poster.label",
      "info": "t:sections.hero_editorial.settings.video_poster.info"
    },
    {
      "type": "checkbox",
      "id": "enable_video_mobile",
      "label": "t:sections.hero_editorial.settings.enable_video_mobile.label",
      "info": "t:sections.hero_editorial.settings.enable_video_mobile.info",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "t:sections.all.image_desktop.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.all.image_mobile.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.all.image_alt.label",
      "info": "t:sections.hero_editorial.settings.image_alt.info"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:sections.hero_editorial.settings.overlay_style.label",
      "info": "t:sections.hero_editorial.settings.overlay_style.info",
      "options": [
        { "value": "none", "label": "t:sections.hero_editorial.settings.overlay_style.options__1.label" },
        { "value": "scrim", "label": "t:sections.hero_editorial.settings.overlay_style.options__2.label" },
        { "value": "gradient_bottom", "label": "t:sections.hero_editorial.settings.overlay_style.options__3.label" },
        { "value": "gradient_content", "label": "t:sections.hero_editorial.settings.overlay_style.options__4.label" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:sections.hero_editorial.settings.overlay_opacity.label",
      "info": "t:sections.hero_editorial.settings.overlay_opacity.info",
      "default": 40
    },
    {
      "type": "select",
      "id": "content_position_x",
      "label": "t:sections.hero_editorial.settings.content_position_x.label",
      "options": [
        { "value": "start", "label": "t:sections.hero_editorial.settings.content_position_x.options__1.label" },
        { "value": "center", "label": "t:sections.hero_editorial.settings.content_position_x.options__2.label" },
        { "value": "end", "label": "t:sections.hero_editorial.settings.content_position_x.options__3.label" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "content_position_y",
      "label": "t:sections.hero_editorial.settings.content_position_y.label",
      "options": [
        { "value": "start", "label": "t:sections.hero_editorial.settings.content_position_y.options__1.label" },
        { "value": "center", "label": "t:sections.hero_editorial.settings.content_position_y.options__2.label" },
        { "value": "end", "label": "t:sections.hero_editorial.settings.content_position_y.options__3.label" }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.hero_editorial.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.hero_editorial.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.hero_editorial.settings.text_alignment.options__2.label" },
        { "value": "right", "label": "t:sections.hero_editorial.settings.text_alignment.options__3.label" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "%",
      "label": "t:sections.hero_editorial.settings.content_width.label",
      "default": 38
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.hero_editorial.settings.heading_tag.label",
      "info": "t:sections.hero_editorial.settings.heading_tag.info",
      "options": [
        { "value": "auto", "label": "t:sections.hero_editorial.settings.heading_tag.options__3.label" },
        { "value": "h1", "label": "t:sections.hero_editorial.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.hero_editorial.settings.heading_tag.options__2.label" }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label",
      "default": "THE EDIT / SARTORIAL 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Autumn / Winter 26"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "<p>A study in quiet movement. Sculptural layers and tactile materials, made in small series.</p>"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "t:sections.hero_editorial.settings.button_primary_label.label",
      "default": "Discover the collection"
    },
    {
      "type": "url",
      "id": "button_primary_url",
      "label": "t:sections.hero_editorial.settings.button_primary_url.label",
      "default": "/collections/all",
      "info": "t:sections.hero_editorial.settings.button_primary_url.info"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "t:sections.hero_editorial.settings.button_secondary_label.label",
      "default": "Explore lookbook"
    },
    {
      "type": "url",
      "id": "button_secondary_url",
      "label": "t:sections.hero_editorial.settings.button_secondary_url.label",
      "default": "/collections",
      "info": "t:sections.hero_editorial.settings.button_secondary_url.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_editorial.presets.name"
    }
  ]
}
{% endschema %}
