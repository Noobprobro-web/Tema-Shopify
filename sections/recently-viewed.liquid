{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.recently_viewed.heading' | t
  endif
  if request.locale.iso_code == 'es'
    if eyebrow == 'Recently viewed'
      assign eyebrow = 'Vistos recientemente'
    endif
    if heading == 'Pieces you considered'
      assign heading = 'Piezas que has explorado'
    endif
  endif
-%}

<recently-viewed
  class="recently-viewed color-{{ section_scheme }}"
  data-section-id="{{ section.id }}"
  data-search-url="{{ routes.search_url | escape }}"
  data-current-product-id="{% if template.name == 'product' %}{{ product.id }}{% endif %}"
  data-products-to-show="{{ section.settings.products_to_show }}"
  data-show-secondary-image="{{ section.settings.show_secondary_image }}"
  data-show-vendor="{{ section.settings.show_vendor }}"
  data-show-quick-add="{{ section.settings.show_quick_add }}"
  aria-busy="false"
  hidden
>
  <section class="section recently-viewed__content" aria-labelledby="RecentlyViewedTitle-{{ section.id }}">
    <div class="container flow">
      <header class="recently-viewed__header">
        {%- if eyebrow != blank -%}
          <p class="eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="RecentlyViewedTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </header>

      <ul class="recently-viewed__grid unstyled-list" data-recently-viewed-grid data-columns="{{ section.settings.columns_desktop }}">
        {%- if search.performed and search.results_count > 0 -%}
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              <li data-recently-viewed-card data-product-id="{{ result.id }}">
                {% render 'product-card',
                  card_product: result,
                  show_secondary_image: true,
                  show_vendor: true,
                  show_quick_add: true
                %}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>
</recently-viewed>

{% schema %}
{
  "name": "t:sections.recently_viewed.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "info": "t:sections.recently_viewed.settings.heading.info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.all.products_to_show.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.all.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.all.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.all.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.all.columns_desktop.options__3.label" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.all.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.all.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.all.show_quick_add.label",
      "default": true
    }
  ],
  "presets": [
    { "name": "t:sections.recently_viewed.presets.name" }
  ]
}
{% endschema %}
