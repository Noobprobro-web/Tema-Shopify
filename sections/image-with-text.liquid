{{ 'section-standard-b.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign image = section.settings.image
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  # Column weights (fr) for the image and the text, and the crop of the image frame.
  assign media_fr = 1
  assign copy_fr = 1
  assign media_sizes = '(min-width: 48rem) 50vw, 100vw'
  if section.settings.image_width == 'large'
    assign media_fr = 3
    assign copy_fr = 2
    assign media_sizes = '(min-width: 48rem) 60vw, 100vw'
  endif

  assign media_ratio = image.aspect_ratio | default: 1.25
  case section.settings.image_ratio
    when 'portrait'
      assign media_ratio = '4 / 5'
    when 'square'
      assign media_ratio = '1 / 1'
    when 'landscape'
      assign media_ratio = '3 / 2'
  endcase

  assign media_order_desktop = 0
  if section.settings.layout == 'text_first'
    assign media_order_desktop = 2
  endif
  assign media_order_mobile = 0
  if section.settings.mobile_order == 'text_first'
    assign media_order_mobile = 2
  endif

  assign has_button = false
  if section.settings.button_label != blank and section.settings.button_url != blank
    assign has_button = true
  endif
  assign button_class = 'button'
  if section.settings.button_style == 'secondary'
    assign button_class = 'button button--secondary'
  endif
  assign image_decorative = false
  if image.alt == blank and section.settings.image_alt == blank and section.settings.heading != blank
    assign image_decorative = true
  endif
-%}

<section
  class="section image-text color-{{ section_scheme }}"
  style="--image-text-media-fr: {{ media_fr }}; --image-text-copy-fr: {{ copy_fr }}; --image-text-ratio: {{ media_ratio }}; --image-text-order-desktop: {{ media_order_desktop }}; --image-text-order-mobile: {{ media_order_mobile }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="ImageTextTitle-{{ section.id }}"
  {% else %}
    aria-label="{{ 'sections.image_with_text.region_label' | t }}"
  {% endif %}
>
  <div class="image-text__inner image-text__inner--{{ section.settings.text_position }}{% if section.settings.layout == 'text_first' %} image-text__inner--text-first{% endif %}">
    <div class="image-text__media">
      {%- if image != blank -%}
        {% render 'responsive-image',
          image: image,
          sizes: media_sizes,
          widths: '480, 750, 960, 1200, 1600',
          prioritize: is_first_section,
          image_class: 'image-text__image',
          alt: section.settings.image_alt,
          decorative: image_decorative
        %}
      {%- else -%}
        <div class="image-text__placeholder" aria-hidden="true">
          {{- 'lifestyle-1' | placeholder_svg_tag: 'homepage-placeholder' -}}
        </div>
      {%- endif -%}
    </div>

    <div class="image-text__copy flow">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} id="ImageTextTitle-{{ section.id }}" class="image-text__heading">
          {{- section.settings.heading | escape -}}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="image-text__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if has_button -%}
        <a class="{{ button_class }} image-text__button" href="{{ section.settings.button_url | escape }}">
          <span>{{ section.settings.button_label | escape }}</span>
          {% render 'icon', name: 'arrow', size: 18 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.all.image_alt.label",
      "info": "t:sections.image_with_text.settings.image_alt.info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.settings.layout.label",
      "options": [
        { "value": "image_first", "label": "t:sections.image_with_text.settings.layout.options__1.label" },
        { "value": "text_first", "label": "t:sections.image_with_text.settings.layout.options__2.label" }
      ],
      "default": "image_first"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "t:sections.image_with_text.settings.image_width.label",
      "options": [
        { "value": "medium", "label": "t:sections.image_with_text.settings.image_width.options__1.label" },
        { "value": "large", "label": "t:sections.image_with_text.settings.image_width.options__2.label" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image_with_text.settings.image_ratio.label",
      "info": "t:sections.image_with_text.settings.image_ratio.info",
      "options": [
        { "value": "adapt", "label": "t:sections.image_with_text.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.image_with_text.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.image_with_text.settings.image_ratio.options__3.label" },
        { "value": "landscape", "label": "t:sections.image_with_text.settings.image_ratio.options__4.label" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "t:sections.image_with_text.settings.text_position.label",
      "options": [
        { "value": "start", "label": "t:sections.image_with_text.settings.text_position.options__1.label" },
        { "value": "center", "label": "t:sections.image_with_text.settings.text_position.options__2.label" },
        { "value": "end", "label": "t:sections.image_with_text.settings.text_position.options__3.label" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "t:sections.image_with_text.settings.mobile_order.label",
      "options": [
        { "value": "image_first", "label": "t:sections.image_with_text.settings.layout.options__1.label" },
        { "value": "text_first", "label": "t:sections.image_with_text.settings.layout.options__2.label" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Image with text"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.image_with_text.settings.heading_tag.label",
      "info": "t:sections.image_with_text.settings.heading_tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.image_with_text.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.image_with_text.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.image_with_text.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "<p>Pair an image with the story behind it: a material, a process or a collection.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button_label.label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:sections.all.button_url.label",
      "info": "t:sections.all.button_url.info"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.image_with_text.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:sections.image_with_text.settings.button_style.options__1.label" },
        { "value": "secondary", "label": "t:sections.image_with_text.settings.button_style.options__2.label" }
      ],
      "default": "secondary"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.name"
    }
  ]
}
{% endschema %}
