{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
-%}

<curated-showcase>
  <section
    class="section curated-showcase color-{{ section_scheme }}"
    {% if section.settings.heading != blank %}
      aria-labelledby="CuratedShowcaseTitle-{{ section.id }}"
    {% else %}
      aria-label="{{ 'sections.homepage.curated.region_label' | t }}"
    {% endif %}
  >
    <div class="curated-showcase__inner">
      <header class="curated-showcase__header">
        <div class="flow">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 id="CuratedShowcaseTitle-{{ section.id }}" class="curated-showcase__heading">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="curated-showcase__subheading rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div
            class="curated-showcase__tabs"
            role="tablist"
            aria-label="{{ 'sections.homepage.curated.tabs_label' | t }}"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign tab_number = forloop.index | prepend: '0'
                assign tab_label = block.settings.tab_label | default: block.settings.collection.title
                if tab_label == blank
                  assign tab_label = 'sections.homepage.curated.tab_fallback' | t: number: tab_number
                endif
              -%}
              <button
                id="CuratedTab-{{ section.id }}-{{ block.id }}"
                class="curated-showcase__tab"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="CuratedPanel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-curated-tab
              >
                <span aria-hidden="true">[{{ tab_number }}]</span>
                <span>{{ tab_label | escape }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </header>

      <div class="curated-showcase__panels">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_number = forloop.index | prepend: '0'
            assign tab_collection = block.settings.collection
            assign tab_label = block.settings.tab_label | default: tab_collection.title
            if tab_label == blank
              assign tab_label = 'sections.homepage.curated.tab_fallback' | t: number: tab_number
            endif
            assign collection_url = tab_collection.url | default: routes.all_products_collection_url
            assign spotlight_product = tab_collection.products.first
            assign spotlight_image = block.settings.editorial_image | default: spotlight_product.featured_media.preview_image | default: tab_collection.image
            assign spotlight_title = spotlight_product.title | default: tab_label
            assign spotlight_url = spotlight_product.url | default: collection_url
            assign spotlight_alt = spotlight_image.alt | default: spotlight_title
          -%}
          <div
            id="CuratedPanel-{{ section.id }}-{{ block.id }}"
            class="curated-showcase__panel"
            role="tabpanel"
            aria-labelledby="CuratedTab-{{ section.id }}-{{ block.id }}"
            data-curated-panel
            {% unless forloop.first %}hidden inert{% endunless %}
            {{ block.shopify_attributes }}
          >
            <article class="curated-showcase__spotlight">
              <a
                class="curated-showcase__spotlight-media"
                href="{{ spotlight_url }}"
                aria-label="{{ 'sections.homepage.curated.open_spotlight' | t: title: spotlight_title | escape }}"
              >
                {%- if spotlight_image != blank -%}
                  {% render 'responsive-image',
                    image: spotlight_image,
                    sizes: '(min-width: 62rem) 52vw, 100vw',
                    widths: '480, 750, 960, 1200, 1600',
                    image_class: 'curated-showcase__spotlight-image',
                    alt: spotlight_alt
                  %}
                {%- else -%}
                  <span class="curated-showcase__placeholder" aria-hidden="true">
                    {{- 'product-1' | placeholder_svg_tag: 'homepage-placeholder' -}}
                  </span>
                {%- endif -%}
              </a>
              <div class="curated-showcase__spotlight-details">
                <p class="eyebrow">{{ 'sections.homepage.curated.spotlight' | t }}</p>
                <h3 class="curated-showcase__spotlight-title">
                  <a href="{{ spotlight_url }}">{{ spotlight_title | escape }}</a>
                </h3>
                {%- if spotlight_product != blank -%}
                  {% render 'price', product: spotlight_product, show_badges: true, show_unit_price: false %}
                {%- endif -%}
              </div>
            </article>

            <div class="curated-showcase__supporting">
              {%- for card_product in tab_collection.products limit: 2 offset: 1 -%}
                {% render 'product-card',
                  card_product: card_product,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_quick_add: false
                %}
              {%- else -%}
                {%- for placeholder_index in (1..2) -%}
                  {%- assign placeholder_name = 'product-' | append: placeholder_index | append: '' -%}
                  <article class="product-card curated-showcase__placeholder-card" aria-hidden="true">
                    <div class="product-card__media">
                      {{- placeholder_name | placeholder_svg_tag: 'homepage-placeholder' -}}
                    </div>
                    <div class="product-card__content">
                      <span class="curated-showcase__placeholder-line"></span>
                      <span class="curated-showcase__placeholder-line curated-showcase__placeholder-line--short"></span>
                    </div>
                  </article>
                {%- endfor -%}
              {%- endfor -%}
            </div>

            <footer class="curated-showcase__footer">
              <span aria-hidden="true">{{ tab_number }} / {{ section.blocks.size | prepend: '0' }}</span>
              <a href="{{ collection_url }}">
                <span>{{ 'sections.homepage.curated.view_collection' | t: title: tab_label | escape }}</span>
                {% render 'icon', name: 'arrow', size: 18 %}
              </a>
            </footer>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</curated-showcase>

{% schema %}
{
  "name": "Curated showcase",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CURATED EDIT / 02"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected forms for the season"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label"
        },
        {
          "type": "image_picker",
          "id": "editorial_image",
          "label": "Editorial spotlight image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated showcase",
      "blocks": [
        { "type": "collection_tab" },
        { "type": "collection_tab" },
        { "type": "collection_tab" }
      ]
    }
  ]
}
{% endschema %}
