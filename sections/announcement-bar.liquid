{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign announcement_count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign announcement_count = announcement_count | plus: 1
    endif
  endfor
  assign rotation_interval = section.settings.change_slides_speed | times: 1000
-%}

{%- if announcement_count > 0 -%}
  <announcement-bar
    class="announcement-bar color-{{ section_scheme }}"
    role="region"
    aria-label="{{ 'sections.announcement_bar.region_label' | t }}"
    data-auto-rotate="{{ section.settings.auto_rotate }}"
    data-single-announcement="{% if announcement_count == 1 %}true{% else %}false{% endif %}"
    data-interval="{{ rotation_interval }}"
  >
    <div class="announcement-bar__inner">
      <button
        class="announcement-bar__control announcement-bar__control--previous"
        type="button"
        aria-label="{{ 'sections.announcement_bar.previous' | t }}"
        data-announcement-previous
        {% if announcement_count == 1 %}hidden{% endif %}
      >
        {% render 'icon', name: 'chevron-down', size: 18 %}
      </button>

      <div class="announcement-bar__viewport">
        {%- assign announcement_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.text == blank -%}
            {%- continue -%}
          {%- endif -%}
          <p
            class="announcement-bar__item"
            data-announcement-item
            {% if announcement_index > 0 %}hidden aria-hidden="true"{% else %}aria-hidden="false"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a class="announcement-bar__link" href="{{ block.settings.link }}">
                {{- block.settings.text | escape -}}
              </a>
            {%- else -%}
              <span class="announcement-bar__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </p>
          {%- assign announcement_index = announcement_index | plus: 1 -%}
        {%- endfor -%}
      </div>

      <button
        class="announcement-bar__control announcement-bar__control--pause"
        type="button"
        aria-label="{{ 'sections.announcement_bar.pause' | t }}"
        data-pause-label="{{ 'sections.announcement_bar.pause' | t | escape }}"
        data-play-label="{{ 'sections.announcement_bar.play' | t | escape }}"
        data-announcement-pause
        {% if announcement_count == 1 or section.settings.auto_rotate == false %}hidden{% endif %}
      >
        <span class="announcement-bar__pause-icon" aria-hidden="true"></span>
        <span class="announcement-bar__play-icon" aria-hidden="true"></span>
      </button>

      <button
        class="announcement-bar__control announcement-bar__control--next"
        type="button"
        aria-label="{{ 'sections.announcement_bar.next' | t }}"
        data-announcement-next
        {% if announcement_count == 1 %}hidden{% endif %}
      >
        {% render 'icon', name: 'chevron-down', size: 18 %}
      </button>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-announcement-status></p>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement_bar.settings.auto_rotate.label",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement_bar.settings.change_slides_speed.label",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "Complimentary shipping on orders over $150"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.all.link.label",
          "info": "t:sections.all.link_destination_info"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "t:sections.announcement_bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
