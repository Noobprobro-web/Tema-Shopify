{{ 'section-standard-a.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign title_id = 'CollectionListTitle-' | append: section.id
  assign image_ratio = section.settings.image_ratio | default: 'portrait'

  # The cards sit one level below the section heading; with no heading they take its level.
  assign card_tag = heading_tag
  if section.settings.heading != blank
    if heading_tag == 'h2'
      assign card_tag = 'h3'
    else
      assign card_tag = 'h4'
    endif
  endif

  assign columns_mobile = section.settings.columns_mobile | default: 2 | plus: 0
  assign columns_desktop = section.settings.columns_desktop | default: 3 | plus: 0
  assign columns_tablet = columns_desktop | at_most: 3


  # Only the first section on the page loads its images eagerly.
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign grid_is_single = false
  if section.blocks.size == 1
    assign grid_is_single = true
  endif

  # A lone card sits in a grid capped at 28rem (448px) that keeps its column tracks and the 12px gap
  # (see .std-grid--single in section-standard-a.css), so it is narrower than a share of the viewport.
  capture image_sizes
    if grid_is_single
      render 'card-sizes', columns_mobile: columns_mobile, columns_tablet: columns_tablet, columns_desktop: columns_desktop, max_width: 448, gap: 12
    else
      render 'card-sizes', columns_mobile: columns_mobile, columns_tablet: columns_tablet, columns_desktop: columns_desktop
    endif
  endcapture
-%}

{%- if section.blocks.size > 0 or request.design_mode -%}
  <section
    class="section std-section collection-list collection-list--{{ image_ratio }} color-{{ section_scheme }}"
    style="--std-padding-top: {{ section.settings.padding_top }}px; --std-padding-bottom: {{ section.settings.padding_bottom }}px; --std-columns-mobile: {{ columns_mobile }}; --std-columns-tablet: {{ columns_tablet }}; --std-columns-desktop: {{ columns_desktop }};"
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ title_id }}"
    {% else %}
      aria-label="{{ 'sections.collection_list.region_label' | t }}"
    {% endif %}
  >
    <div class="std-section__inner">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <header class="std-section__header">
          <div class="std-section__title-group">
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <{{ heading_tag }} id="{{ title_id }}" class="std-section__heading">
                {{- section.settings.heading | escape -}}
              </{{ heading_tag }}>
            {%- endif -%}
          </div>
        </header>
      {%- endif -%}

      {%- if section.blocks.size == 0 -%}
        <p class="std-section__note">{{ 'sections.collection_list.add_collections' | t }}</p>
        <ul class="std-grid" aria-hidden="true">
          {%- for placeholder_index in (1..columns_desktop) -%}
            <li>
              <div class="collection-list__card">
                <div class="collection-list__media">
                  {{- 'collection-' | append: placeholder_index | placeholder_svg_tag: 'homepage-placeholder' -}}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <ul class="std-grid{% if grid_is_single %} std-grid--single{% endif %}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_collection = block.settings.collection
              assign card_image = block.settings.image | default: block_collection.featured_image | default: block_collection.products.first.featured_media.preview_image
              assign card_title = block_collection.title
              if card_title == blank
                assign card_title = 'sections.collection_list.placeholder_title' | t
              endif
              assign placeholder_number = forloop.index0 | modulo: 6 | plus: 1
              assign placeholder_name = 'collection-' | append: placeholder_number
              assign eager_card = false
              if is_first_section and forloop.index <= columns_desktop
                assign eager_card = true
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              <article class="collection-list__card">
                <div class="collection-list__media">
                  {%- if card_image != blank -%}
                    {% render 'responsive-image',
                      image: card_image,
                      eager: eager_card,
                      sizes: image_sizes,
                      widths: '320, 480, 640, 800, 1000, 1200',
                      image_class: 'collection-list__image',
                      decorative: true
                    %}
                  {%- else -%}
                    {{- placeholder_name | placeholder_svg_tag: 'homepage-placeholder' -}}
                  {%- endif -%}
                </div>
                <div class="collection-list__caption">
                  <{{ card_tag }} class="collection-list__title">
                    {%- if block_collection != blank -%}
                      <a href="{{ block_collection.url }}">{{ card_title | escape }}</a>
                    {%- else -%}
                      {{ card_title | escape }}
                    {%- endif -%}
                  </{{ card_tag }}>
                  {%- if section.settings.show_product_count and block_collection != blank -%}
                    <p class="collection-list__count">
                      {{- 'list_collections.product_count' | t: count: block_collection.products_count -}}
                    </p>
                  {%- endif -%}
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Shop by collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.collection_list.settings.heading_tag.label",
      "info": "t:sections.collection_list.settings.heading_tag.info",
      "options": [
        { "value": "h2", "label": "t:sections.collection_list.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.collection_list.settings.heading_tag.options__2.label" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:sections.collection_list.settings.show_product_count.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.layout_header.content"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.collection_list.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.collection_list.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.collection_list.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.collection_list.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.collection_list.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.collection_list.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.collection_list.settings.columns_mobile.options__2.label" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection_list.settings.image_ratio.label",
      "options": [
        { "value": "portrait", "label": "t:sections.collection_list.settings.image_ratio.options__1.label" },
        { "value": "square", "label": "t:sections.collection_list.settings.image_ratio.options__2.label" },
        { "value": "landscape", "label": "t:sections.collection_list.settings.image_ratio.options__3.label" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.appearance_header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_product.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_product.settings.padding_bottom.label",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.all.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_list.blocks.collection.settings.image.label",
          "info": "t:sections.collection_list.blocks.collection.settings.image.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
