{{ 'section-standard-b.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-standard-b.js' | asset_url }}" defer></script>

{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign slide_total = section.blocks.size
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif
  assign autoplay = false
  if section.settings.autoplay and slide_total > 1
    assign autoplay = true
  endif
  assign autoplay_delay = section.settings.autoplay_delay | default: 5 | times: 1000
-%}

<theme-slideshow
  class="slideshow-wrapper"
  data-autoplay="{{ autoplay }}"
  data-delay="{{ autoplay_delay }}"
  data-pause-label="{{ 'sections.slideshow.pause' | t | escape }}"
  data-play-label="{{ 'sections.slideshow.play' | t | escape }}"
  data-status-template="{{ 'sections.slideshow.slide_status' | t: current: '__current__', total: '__total__' | escape_once }}"
>
  <section
    class="section slideshow color-{{ section_scheme }}"
    style="--slideshow-height-desktop: {{ section.settings.height_desktop }}; --slideshow-height-mobile: {{ section.settings.height_mobile }};"
    {% if section.index != blank %}
      aria-label="{{ 'sections.slideshow.region_label_numbered' | t: number: section.index }}"
    {% else %}
      aria-label="{{ 'sections.slideshow.region_label' | t }}"
    {% endif %}
  >
    <div class="slideshow__viewport">
    <div
      class="slideshow__track"
      data-slideshow-track
      {% if slide_total > 1 %}
        tabindex="0"
        role="group"
        aria-roledescription="{{ 'sections.slideshow.carousel_role' | t }}"
        aria-label="{{ 'sections.slideshow.track_label' | t }}"
      {% endif %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_image = block.settings.image | default: block.settings.image_mobile
          assign slide_alt = block.settings.image_alt | default: slide_image.alt
          assign slide_decorative = false
          if slide_alt == blank and block.settings.heading != blank
            assign slide_decorative = true
          endif
          assign slide_overlay = block.settings.overlay_opacity | divided_by: 100.0
          assign slide_prioritize = false
          if is_first_section and forloop.first
            assign slide_prioritize = true
          endif
          assign has_button = false
          if block.settings.button_label != blank and block.settings.button_url != blank
            assign has_button = true
          endif
        -%}
        <div
          class="slideshow__slide slideshow__slide--{{ block.settings.text_alignment }}{% if slide_image != blank %} slideshow__slide--image{% endif %}"
          style="--slide-veil: {{ slide_overlay }}; --slide-focal: {{ slide_image.presentation.focal_point | default: 'center' }};"
          data-slideshow-slide
          {% if slide_total > 1 %}
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide_role' | t }}"
            aria-label="{{ 'sections.slideshow.slide_label' | t: current: forloop.index, total: slide_total }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="slideshow__media">
            {%- if slide_image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank and block.settings.image != blank -%}
                  <source
                    media="(max-width: 47.99rem)"
                    srcset="
                      {{ block.settings.image_mobile | image_url: width: 390 }} 390w,
                      {{ block.settings.image_mobile | image_url: width: 550 }} 550w,
                      {{ block.settings.image_mobile | image_url: width: 750 }} 750w
                    "
                    sizes="100vw"
                    width="{{ block.settings.image_mobile.width }}"
                    height="{{ block.settings.image_mobile.height }}"
                  >
                {%- endif -%}
                {% render 'responsive-image',
                  image: slide_image,
                  sizes: '100vw',
                  widths: '550, 750, 960, 1200, 1600, 2000, 2400',
                  prioritize: slide_prioritize,
                  image_class: 'slideshow__image',
                  alt: slide_alt,
                  decorative: slide_decorative
                %}
              </picture>
              <span class="slideshow__veil" aria-hidden="true"></span>
            {%- else -%}
              <div class="slideshow__placeholder" aria-hidden="true">
                {{- 'lifestyle-1' | placeholder_svg_tag: 'homepage-placeholder' -}}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank or has_button -%}
            <div class="slideshow__content">
              <div class="slideshow__copy flow">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <{{ heading_tag }} class="slideshow__heading">{{ block.settings.heading | escape }}</{{ heading_tag }}>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="slideshow__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if has_button -%}
                  <a class="button slideshow__button" href="{{ block.settings.button_url | escape }}">
                    <span>{{ block.settings.button_label | escape }}</span>
                    {% render 'icon', name: 'arrow', size: 18 %}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="slideshow__slide">
          <div class="slideshow__media">
            <div class="slideshow__placeholder" aria-hidden="true">
              {{- 'lifestyle-1' | placeholder_svg_tag: 'homepage-placeholder' -}}
            </div>
          </div>
          {%- if request.design_mode -%}
            <div class="slideshow__content">
              <p class="slideshow__copy">{{ 'sections.slideshow.empty' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    </div>

    {%- if slide_total > 1 -%}
      <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-slideshow-status></p>
      <div class="slideshow__controls" data-slideshow-controls hidden>
        <div class="slideshow__nav">
          <button
            class="slideshow__arrow slideshow__arrow--previous"
            type="button"
            aria-label="{{ 'sections.slideshow.previous' | t | escape }}"
            data-slideshow-previous
          >
            {% render 'icon', name: 'arrow', size: 18 %}
          </button>
          <button
            class="slideshow__arrow slideshow__arrow--next"
            type="button"
            aria-label="{{ 'sections.slideshow.next' | t | escape }}"
            data-slideshow-next
          >
            {% render 'icon', name: 'arrow', size: 18 %}
          </button>
        </div>

        {%- if autoplay -%}
          <button
            class="slideshow__pause"
            type="button"
            aria-label="{{ 'sections.slideshow.pause' | t | escape }}"
            data-slideshow-toggle
            hidden
          >
            <span class="slideshow__pause-icon" aria-hidden="true"></span>
            <span class="slideshow__play-icon" aria-hidden="true"></span>
          </button>
        {%- endif -%}

        <ul class="slideshow__dots unstyled-list">
          {%- for block in section.blocks -%}
            <li>
              <button
                class="slideshow__dot"
                type="button"
                aria-label="{{ 'sections.slideshow.go_to_slide' | t: number: forloop.index | escape_once }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                data-slideshow-dot
              ></button>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </section>
</theme-slideshow>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.slideshow.settings.height_desktop.label",
      "info": "t:sections.slideshow.settings.height_desktop.info",
      "default": 80
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.slideshow.settings.height_mobile.label",
      "info": "t:sections.slideshow.settings.height_mobile.info",
      "default": 70
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.slideshow.settings.heading_tag.label",
      "info": "t:sections.slideshow.settings.heading_tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.slideshow.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.slideshow.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.slideshow.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.settings.autoplay.label",
      "info": "t:sections.slideshow.settings.autoplay.info",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "t:sections.slideshow.settings.autoplay_delay.label",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image_desktop.label"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:sections.all.image_mobile.label"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.all.image_alt.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image_alt.info"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "t:sections.slideshow.blocks.slide.settings.overlay_opacity.label",
          "info": "t:sections.slideshow.blocks.slide.settings.overlay_opacity.info",
          "default": 30
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.label",
          "options": [
            { "value": "start", "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.options__1.label" },
            { "value": "center", "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.options__2.label" },
            { "value": "end", "label": "t:sections.slideshow.blocks.slide.settings.text_alignment.options__3.label" }
          ],
          "default": "start"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.all.eyebrow.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "Slide heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "<p>Share a short message about this slide.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.all.button_label.label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "t:sections.all.button_url.label",
          "info": "t:sections.all.button_url.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.name",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
