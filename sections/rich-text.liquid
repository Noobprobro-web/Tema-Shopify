{{ 'section-standard-a.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign title_id = 'RichTextTitle-' | append: section.id
  assign text_alignment = section.settings.text_alignment | default: 'start'
  assign content_width = section.settings.content_width | default: 'standard'

  # A button needs both a label and a destination.
  assign button_count = 0
  for block in section.blocks
    if block.settings.label != blank and block.settings.url != blank
      assign button_count = button_count | plus: 1
    endif
  endfor

  assign has_content = false
  if section.settings.heading != blank or section.settings.text != blank or section.settings.eyebrow != blank or button_count > 0
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <section
    class="section std-section rich-text rich-text--{{ text_alignment }} rich-text--{{ content_width }} color-{{ section_scheme }}"
    style="--std-padding-top: {{ section.settings.padding_top }}px; --std-padding-bottom: {{ section.settings.padding_bottom }}px;"
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ title_id }}"
    {% else %}
      aria-label="{{ 'sections.rich_text.region_label' | t }}"
    {% endif %}
  >
    <div class="rich-text__inner">
      <div class="rich-text__content">
        {%- unless has_content -%}
          <p class="std-section__note">{{ 'sections.rich_text.add_content' | t }}</p>
        {%- endunless -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} id="{{ title_id }}" class="rich-text__heading">
            {{- section.settings.heading | escape -}}
          </{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rich-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if button_count > 0 -%}
          <div class="rich-text__actions">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank and block.settings.url != blank -%}
                <a
                  class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}"
                  href="{{ block.settings.url }}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.label | escape -}}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Introduce your store"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.rich_text.settings.heading_tag.label",
      "info": "t:sections.rich_text.settings.heading_tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.rich_text.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.rich_text.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.rich_text.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "<p>Use this space to say what you sell, what makes it different, or what customers should know before they shop.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.layout_header.content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.rich_text.settings.text_alignment.label",
      "info": "t:sections.rich_text.settings.text_alignment.info",
      "options": [
        { "value": "start", "label": "t:sections.rich_text.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.rich_text.settings.text_alignment.options__2.label" },
        { "value": "end", "label": "t:sections.rich_text.settings.text_alignment.options__3.label" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.rich_text.settings.content_width.label",
      "options": [
        { "value": "narrow", "label": "t:sections.rich_text.settings.content_width.options__1.label" },
        { "value": "standard", "label": "t:sections.rich_text.settings.content_width.options__2.label" },
        { "value": "wide", "label": "t:sections.rich_text.settings.content_width.options__3.label" }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.appearance_header.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_product.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.featured_product.settings.padding_bottom.label",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "t:sections.rich_text.blocks.button.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.all.button_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.all.button_url.label",
          "info": "t:sections.all.button_url.info"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.rich_text.blocks.button.settings.style.label",
          "options": [
            { "value": "primary", "label": "t:sections.rich_text.blocks.button.settings.style.options__1.label" },
            { "value": "secondary", "label": "t:sections.rich_text.blocks.button.settings.style.options__2.label" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.presets.name"
    }
  ]
}
{% endschema %}
