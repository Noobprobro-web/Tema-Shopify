{{ 'section-standard-b.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-standard-b.js' | asset_url }}" defer></script>

{%- liquid
  assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
  assign section_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: default_scheme_id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign hosted_video = section.settings.video
  assign external_video = section.settings.video_url
  assign cover = section.settings.cover_image | default: hosted_video.preview_image
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign has_video = false
  if hosted_video != blank or external_video != blank
    assign has_video = true
  endif

  assign default_title = 'sections.video.default_title' | t
  assign video_title = section.settings.video_title | default: section.settings.heading | default: default_title

  # Plain address used only when scripts are off.
  assign watch_url = ''
  if hosted_video != blank
    assign watch_url = hosted_video.sources.first.url
  elsif external_video.type == 'youtube'
    assign watch_url = 'https://www.youtube.com/watch?v=' | append: external_video.id
  elsif external_video.type == 'vimeo'
    assign watch_url = 'https://vimeo.com/' | append: external_video.id
  endif

  assign ratio = '16 / 9'
  case section.settings.aspect_ratio
    when '21_9'
      assign ratio = '21 / 9'
    when '4_3'
      assign ratio = '4 / 3'
    when '1_1'
      assign ratio = '1 / 1'
  endcase
-%}

<section
  class="section video-section video-section--{{ section.settings.width }} color-{{ section_scheme }}"
  style="--video-ratio: {{ ratio }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="VideoTitle-{{ section.id }}"
  {% else %}
    aria-label="{{ 'sections.video.region_label' | t }}"
  {% endif %}
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
    <header class="video-section__header flow">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} id="VideoTitle-{{ section.id }}" class="video-section__heading">
          {{- section.settings.heading | escape -}}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="video-section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <theme-video-poster class="video-section__frame">
    <div class="video-section__stage" data-video-stage>
      <div class="video-section__poster" data-video-poster>
        {%- if cover != blank -%}
          {% render 'responsive-image',
            image: cover,
            sizes: '(min-width: 62rem) 90vw, 100vw',
            widths: '480, 750, 960, 1200, 1600, 2000, 2400',
            prioritize: is_first_section,
            image_class: 'video-section__image',
            decorative: true
          %}
        {%- else -%}
          <div class="video-section__placeholder" aria-hidden="true">
            {{- 'lifestyle-2' | placeholder_svg_tag: 'homepage-placeholder' -}}
          </div>
        {%- endif -%}
      </div>

      {%- if has_video -%}
        <button
          class="video-section__play"
          type="button"
          aria-label="{{ 'sections.video.play_label' | t: title: video_title | escape }}"
          data-video-play
          hidden
        >
          <span class="video-section__play-pill">
            <span class="video-section__play-icon" aria-hidden="true"></span>
            <span>{{ 'sections.video.play' | t }}</span>
          </span>
        </button>

        <template data-video-template>
          {%- if hosted_video != blank -%}
            {{-
              hosted_video
              | video_tag:
                image_size: '1600x',
                controls: true,
                playsinline: true,
                preload: 'none',
                class: 'video-section__media',
                title: video_title
            -}}
          {%- else -%}
            {%- if external_video.type == 'youtube' -%}
              <iframe
                class="video-section__media"
                src="https://www.youtube-nocookie.com/embed/{{ external_video.id | escape }}?autoplay=1&rel=0&playsinline=1"
                title="{{ video_title | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            {%- elsif external_video.type == 'vimeo' -%}
              <iframe
                class="video-section__media"
                src="https://player.vimeo.com/video/{{ external_video.id | escape }}?autoplay=1"
                title="{{ video_title | escape }}"
                allow="autoplay; picture-in-picture; fullscreen"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            {%- endif -%}
          {%- endif -%}
        </template>

        {%- if watch_url != blank -%}
          <noscript>
            <a class="button video-section__fallback" href="{{ watch_url }}" target="_blank" rel="noopener">
              {{- 'sections.video.watch' | t -}}
            </a>
          </noscript>
        {%- endif -%}
      {%- endif -%}
    </div>
  </theme-video-poster>
</section>

{% schema %}
{
  "name": "t:sections.video.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label",
      "info": "t:sections.video.settings.video.info"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label",
      "info": "t:sections.video.settings.cover_image.info"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "t:sections.video.settings.video_title.label",
      "info": "t:sections.video.settings.video_title.info",
      "default": "Brand film"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.video.settings.width.label",
      "options": [
        { "value": "contained", "label": "t:sections.video.settings.width.options__1.label" },
        { "value": "full", "label": "t:sections.video.settings.width.options__2.label" }
      ],
      "default": "contained"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:sections.video.settings.aspect_ratio.label",
      "options": [
        { "value": "16_9", "label": "t:sections.video.settings.aspect_ratio.options__1.label" },
        { "value": "21_9", "label": "t:sections.video.settings.aspect_ratio.options__2.label" },
        { "value": "4_3", "label": "t:sections.video.settings.aspect_ratio.options__3.label" },
        { "value": "1_1", "label": "t:sections.video.settings.aspect_ratio.options__4.label" }
      ],
      "default": "16_9"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Watch the story"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.video.settings.heading_tag.label",
      "info": "t:sections.video.settings.heading_tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.video.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.video.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.video.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.name"
    }
  ]
}
{% endschema %}
