{%- comment -%}
  Renders Open Graph and Twitter metadata for the current storefront resource.
{%- endcomment -%}

{%- liquid
  assign social_title = page_title | default: shop.name
  assign social_url = canonical_url | default: request.origin
  assign social_type = 'website'
  assign social_description = page_description | default: shop.description | default: shop.name
  assign social_image = page_image

  if request.page_type == 'product'
    assign social_type = 'product'
    assign social_image = product.featured_media.preview_image | default: social_image
  elsif request.page_type == 'article'
    assign social_type = 'article'
    assign social_image = article.image | default: social_image
  elsif request.page_type == 'collection'
    assign social_image = collection.image | default: social_image
  endif

  if social_image == blank and settings.logo != blank
    assign social_image = settings.logo
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ social_url | escape }}">
<meta property="og:title" content="{{ social_title | escape }}">
<meta property="og:type" content="{{ social_type }}">
<meta property="og:description" content="{{ social_description | strip_html | escape }}">

{%- if social_image != blank -%}
  {%- assign social_image_width = social_image.width | at_most: 1200 -%}
  <meta property="og:image" content="http:{{ social_image | image_url: width: social_image_width }}">
  <meta property="og:image:secure_url" content="https:{{ social_image | image_url: width: social_image_width }}">
  <meta property="og:image:width" content="{{ social_image_width }}">
  <meta property="og:image:height" content="{{ social_image.height | times: social_image_width | divided_by: social_image.width }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ social_title | escape }}">
<meta name="twitter:description" content="{{ social_description | strip_html | escape }}">
{%- if social_image != blank -%}
  <meta name="twitter:image" content="https:{{ social_image | image_url: width: social_image_width }}">
{%- endif -%}
