{%- comment -%}
  A question of the FAQ accordion.
  It lives in a snippet because main-faq emits it from two places (the questions without a category
  and those of each category). A single copy of the markup keeps the accordions from drifting apart
  over time.
  Accepts:
    - block: the block with question, answer and open_by_default
{%- endcomment -%}

<details class="faq-item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
  <summary class="faq-item__summary">
    <span>{{ block.settings.question | escape }}</span>
    <span class="faq-item__icon" aria-hidden="true"></span>
  </summary>
  <div class="faq-item__answer rte">{{ block.settings.answer }}</div>
</details>
