{%- comment -%}
  Renders product provenance block for vintage/archive pieces.
  Rows come only from this block's settings, which show as entered for every product that displays the block.
  The unique piece label also checks the product's variant count and inventory settings.
  With every setting empty or off, nothing renders in the storefront.
  Accepts:
  - block: {Object} Block object with settings and shopify_attributes.
  - product: {Object} Product Liquid object.
  - selected_variant: {Object} Selected or first available variant (optional).

  Usage:
  {% render 'product-provenance', block: block, product: product, selected_variant: selected_variant %}
{%- endcomment -%}

{%- liquid
  assign heading_tag = 'h2'
  if section.settings.product != blank
    assign heading_tag = 'h3'
  endif

  assign current_variant = selected_variant | default: product.selected_or_first_available_variant
  assign unique_piece = false
  if block.settings.show_unique_piece and product.variants.size == 1 and current_variant.inventory_management != blank and current_variant.inventory_policy == 'deny'
    assign unique_piece = true
  endif

  # Year, condition grade and notes come only from this block's settings.
  assign provenance_year = block.settings.circa_year | strip
  if provenance_year contains '{{'
    assign provenance_year = ''
  endif

  assign condition_grade_val = block.settings.condition_grade
  assign show_grade = false
  if condition_grade_val != blank and condition_grade_val != 'not_assessed'
    assign show_grade = true
  endif

  assign provenance_notes_val = block.settings.provenance_notes
-%}

{%- if unique_piece or show_grade or provenance_year != blank or provenance_notes_val != blank -%}
  <div class="product-provenance" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <{{ heading_tag }} class="product-provenance__heading">{{ block.settings.heading | escape }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if unique_piece -%}
      <p class="product-provenance__badge">{{ 'products.product.provenance.single_piece' | t }}</p>
    {%- endif -%}
    {%- if provenance_year != blank -%}
      <p class="product-provenance__year">{{ 'products.product.provenance.circa' | t: year: provenance_year | escape }}</p>
    {%- endif -%}
    {%- if show_grade -%}
      <p class="product-provenance__grade">
        <span>{{ 'products.product.provenance.condition' | t }}</span>
        {%- case condition_grade_val -%}
          {%- when 'grade_1' -%}{{ 'products.product.provenance.grade_1' | t }}
          {%- when 'grade_2' -%}{{ 'products.product.provenance.grade_2' | t }}
          {%- when 'grade_3' -%}{{ 'products.product.provenance.grade_3' | t }}
          {%- when 'grade_4' -%}{{ 'products.product.provenance.grade_4' | t }}
          {%- when 'grade_5' -%}{{ 'products.product.provenance.grade_5' | t }}
        {%- endcase -%}
      </p>
    {%- endif -%}
    {%- if provenance_notes_val != blank -%}
      <div class="product-provenance__notes rte">{{- provenance_notes_val -}}</div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="product-provenance" {{ block.shopify_attributes }}>
    <p class="product-provenance__notes">{{ 'products.product.provenance.editor_empty' | t }}</p>
  </div>
{%- endif -%}
