{%- comment -%}
  Renders a small interface icon.

  Accepts:
  - name: menu, close, chevron-down, chevron, search, account, bag, cart,
    check, arrow, or spinner
  - size: optional square size in pixels
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 20
-%}

{%- case name -%}
  {%- when 'menu' -%}
    <svg class="icon icon--menu" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M3 7h18M3 12h18M3 17h18"></path>
    </svg>
  {%- when 'close' -%}
    <svg class="icon icon--close" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="m5 5 14 14M19 5 5 19"></path>
    </svg>
  {%- when 'chevron-down' or 'chevron' -%}
    <svg class="icon icon--chevron" aria-hidden="true" viewBox="0 0 16 16" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="m3 6 5 5 5-5"></path>
    </svg>
  {%- when 'search' -%}
    <svg class="icon icon--search" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
  {%- when 'account' -%}
    <svg class="icon icon--account" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="8" r="3.5"></circle>
      <path d="M5 20c.7-4 3.1-6 7-6s6.3 2 7 6"></path>
    </svg>
  {%- when 'bag' or 'cart' -%}
    <svg class="icon icon--cart" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M5 8h14l-1 12H6L5 8Z"></path>
      <path d="M9 9V6a3 3 0 0 1 6 0v3"></path>
    </svg>
  {%- when 'check' -%}
    <svg class="icon icon--check" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="m4 12 5 5L20 6"></path>
    </svg>
  {%- when 'arrow' -%}
    <svg class="icon icon--arrow" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M4 12h16M14 6l6 6-6 6"></path>
    </svg>
  {%- when 'spinner' -%}
    <svg class="icon icon--spinner" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9" opacity="0.25"></circle>
      <path d="M21 12a9 9 0 0 0-9-9"></path>
    </svg>
{%- endcase -%}
