{%- comment -%}
  Renders a small interface icon.

  Accepts:
  - name: menu, close, chevron-down, chevron, search, account, bag, cart,
    check, arrow, minus, plus, spinner, or a social network (instagram, facebook,
    x, youtube, tiktok, pinterest, snapchat, vimeo, tumblr)
  - size: optional square size in pixels
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 20
-%}

{%- case name -%}
  {%- when 'menu' -%}
    <svg class="icon icon--menu" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M3 7h18M3 12h18M3 17h18"></path>
    </svg>
  {%- when 'close' -%}
    <svg class="icon icon--close" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="m5 5 14 14M19 5 5 19"></path>
    </svg>
  {%- when 'chevron-down' or 'chevron' -%}
    <svg class="icon icon--chevron" aria-hidden="true" viewBox="0 0 16 16" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="m3 6 5 5 5-5"></path>
    </svg>
  {%- when 'search' -%}
    <svg class="icon icon--search" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
  {%- when 'account' -%}
    <svg class="icon icon--account" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="8" r="3.5"></circle>
      <path d="M5 20c.7-4 3.1-6 7-6s6.3 2 7 6"></path>
    </svg>
  {%- when 'bag' or 'cart' -%}
    <svg class="icon icon--cart" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M5 8h14l-1 12H6L5 8Z"></path>
      <path d="M9 9V6a3 3 0 0 1 6 0v3"></path>
    </svg>
  {%- when 'check' -%}
    <svg class="icon icon--check" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="m4 12 5 5L20 6"></path>
    </svg>
  {%- when 'arrow' -%}
    <svg class="icon icon--arrow" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M4 12h16M14 6l6 6-6 6"></path>
    </svg>
  {%- when 'minus' -%}
    <svg class="icon icon--minus" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M5 12h14"></path>
    </svg>
  {%- when 'plus' -%}
    <svg class="icon icon--plus" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 5v14M5 12h14"></path>
    </svg>
  {%- when 'spinner' -%}
    <svg class="icon icon--spinner" aria-hidden="true" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9" opacity="0.25"></circle>
      <path d="M21 12a9 9 0 0 0-9-9"></path>
    </svg>
  {%- when 'instagram' -%}
    <svg class="icon icon--instagram" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17" cy="7" r="0.6" fill="currentColor"></circle>
    </svg>
  {%- when 'facebook' -%}
    <svg class="icon icon--facebook" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.5 21v-8h2.5l.5-3h-3V8.2c0-.9.4-1.2 1.2-1.2h1.8V4.3A16 16 0 0 0 15.2 4c-2.2 0-3.7 1.3-3.7 3.8V10H9v3h2.5v8"></path>
    </svg>
  {%- when 'x' -%}
    <svg class="icon icon--x" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h4l12 16h-4L4 4Z"></path>
      <path d="m4.5 19.5 6-6.5M13.5 11l6-6.5"></path>
    </svg>
  {%- when 'youtube' -%}
    <svg class="icon icon--youtube" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="6" width="18" height="12" rx="3.5"></rect>
      <path d="m10.5 9.5 4.5 2.5-4.5 2.5v-5Z"></path>
    </svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon--tiktok" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"></path>
      <path d="M14 4c.3 2.5 2 4.1 4.5 4.3"></path>
    </svg>
  {%- when 'pinterest' -%}
    <svg class="icon icon--pinterest" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="m10.5 20 2-8.5M9.2 12.5C8 9.8 9.7 7 12.3 7c2.1 0 3.2 1.4 3.2 3.1 0 2.2-1.1 3.9-2.9 3.9-.9 0-1.5-.6-1.5-1.3"></path>
    </svg>
  {%- when 'snapchat' -%}
    <svg class="icon icon--snapchat" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3.5c-2.7 0-4.5 2-4.5 4.7 0 .8 0 1.5.2 2.2-.5.2-1.2.3-2.2.3.3.8 1.1 1.2 2.2 1.3-.4 1.4-1.6 2.4-3.2 2.9.8.9 2.2 1 3.2 1.1.3.6.5 1.3 1.1 1.3 1 0 1.8-.9 3.2-.9s2.2.9 3.2.9c.6 0 .8-.7 1.1-1.3 1-.1 2.4-.2 3.2-1.1-1.6-.5-2.8-1.5-3.2-2.9 1.1-.1 1.9-.5 2.2-1.3-1 0-1.7-.1-2.2-.3.2-.7.2-1.4.2-2.2 0-2.7-1.8-4.7-4.5-4.7Z"></path>
    </svg>
  {%- when 'vimeo' -%}
    <svg class="icon icon--vimeo" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 9.5 1.5 1.5c1.4-1.2 2.2-.7 2.6.9l1.5 5.3c.5 1.8 1.2 2.8 2.2 2.8 1.7 0 3.8-2 6.3-5.7 1.8-2.7 1.7-5-.4-5.5-1.8-.4-3.7.8-4.3 3.5"></path>
    </svg>
  {%- when 'tumblr' -%}
    <svg class="icon icon--tumblr" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.5 20.5c-2.7 0-4-1.4-4-3.8v-6.2H8V7.8c1.8-.6 2.8-2 3.1-4.3h2.6v4h3v3h-3v5.5c0 1.2.6 1.7 1.5 1.7.5 0 1-.1 1.5-.4v2.8c-.6.4-1.5.9-3.2.9Z"></path>
    </svg>
{%- endcase -%}
