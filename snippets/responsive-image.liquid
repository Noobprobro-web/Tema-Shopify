{%- comment -%}
  Renders a responsive Shopify image.

  Accepts:
  - image: Shopify image object
  - sizes: responsive sizes attribute
  - widths: optional width candidates
  - prioritize: eager-load and prioritize the image
  - image_class: optional class
  - alt: optional alt override
{%- endcomment -%}

{%- if image != blank -%}
  {%- liquid
    assign image_sizes = sizes | default: '100vw'
    assign image_widths = widths | default: '320, 480, 640, 800, 960, 1200, 1600, 2000, 2400'
    assign rendered_width = image.width | at_most: 2400
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
    assign image_alt = alt | default: image.alt

    if prioritize
      assign image_loading = 'eager'
      assign image_priority = 'high'
    endif
  -%}

  {{-
    image
    | image_url: width: rendered_width
    | image_tag:
      widths: image_widths,
      sizes: image_sizes,
      loading: image_loading,
      fetchpriority: image_priority,
      class: image_class,
      alt: image_alt
  -}}
{%- endif -%}
