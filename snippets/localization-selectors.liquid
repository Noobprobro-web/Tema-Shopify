{%- comment -%}
  Renders Shopify's native localization form with an ultra-clean, minimal language toggle.
  Accepts:
  - context: 'header', 'header-mobile', etc.
{%- endcomment -%}

{%- liquid
  assign localization_context = context | default: 'default' | handle
  assign localization_form_id = 'LocalizationForm-' | append: localization_context
  assign show_language_selector = false
  assign show_country_selector = false

  if localization.available_languages.size > 1
    assign show_language_selector = true
  endif

  if localization.available_countries.size > 1
    assign show_country_selector = true
  endif
-%}

{%- if show_language_selector or show_country_selector -%}
  <localization-form class="localization-form localization-form--{{ localization_context }}" data-localization-form>
    {%- form 'localization', id: localization_form_id, class: 'localization-form__form' -%}
      {%- if show_language_selector -%}
        <div class="localization-form__toggle" role="group" aria-label="{{ 'general.localization.language' | t }}">
          {%- for language in localization.available_languages -%}
            {%- if language.iso_code == localization.language.iso_code -%}
              <span class="localization-form__item is-active" aria-current="true">
                {%- assign active_language_name = language.endonym_name | capitalize -%}
                <span class="visually-hidden">{{ 'general.localization.current_language' | t: language: active_language_name }}</span>
                <span aria-hidden="true">{{- language.iso_code | upcase -}}</span>
              </span>
            {%- else -%}
              <button
                class="localization-form__item localization-form__btn"
                type="submit"
                name="language_code"
                value="{{ language.iso_code | escape }}"
                aria-label="{{ 'general.localization.update' | t }}: {{ language.endonym_name | capitalize | escape }}"
              >
                {{- language.iso_code | upcase -}}
              </button>
            {%- endif -%}
            {%- unless forloop.last -%}
              <span class="localization-form__divider" aria-hidden="true">/</span>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if show_country_selector -%}
        <div class="localization-form__country-wrapper">
          <label class="visually-hidden" for="{{ localization_form_id }}-country">{{ 'general.localization.country' | t }}</label>
          <select id="{{ localization_form_id }}-country" class="localization-form__country" name="country_code" onchange="this.form.requestSubmit()">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    {%- endform -%}
  </localization-form>
{%- endif -%}
