{%- comment -%}
  Renders Shopify's native localization form with an ultra-clean, minimal language toggle.
  Accepts:
  - context: 'header', 'header-mobile', 'footer', etc.
  - enable_language: false hides the language toggle. Default: shown.
  - enable_country: false hides the currency selector. Default: shown.
  - editor_notice: true lets this instance show the theme editor notice.

  Un selector con un solo valor seria un control muerto: aunque el ajuste este activo,
  cada uno se pinta solo con 2 o mas idiomas o paises. En el editor, la instancia con
  editor_notice explica al comerciante por que no aparece.
{%- endcomment -%}

{%- liquid
  assign localization_context = context | default: 'default' | handle
  assign localization_form_id = 'LocalizationForm-' | append: localization_context
  assign show_language_selector = false
  assign show_country_selector = false
  assign language_needs_setup = false
  assign country_needs_setup = false

  unless enable_language == false
    if localization.available_languages.size > 1
      assign show_language_selector = true
    else
      assign language_needs_setup = true
    endif
  endunless

  unless enable_country == false
    if localization.available_countries.size > 1
      assign show_country_selector = true
    else
      assign country_needs_setup = true
    endif
  endunless

  assign show_editor_notice = false
  if editor_notice and request.design_mode
    if language_needs_setup or country_needs_setup
      assign show_editor_notice = true
    endif
  endif
-%}

{%- if show_language_selector or show_country_selector -%}
  <localization-form class="localization-form localization-form--{{ localization_context }}" data-localization-form>
    {%- form 'localization', id: localization_form_id, class: 'localization-form__form' -%}
      {%- if show_language_selector -%}
        <div class="localization-form__toggle" role="group" aria-label="{{ 'general.localization.language' | t }}">
          {%- for language in localization.available_languages -%}
            {%- if language.iso_code == localization.language.iso_code -%}
              <span class="localization-form__item is-active" aria-current="true">
                {%- assign active_language_name = language.endonym_name | capitalize -%}
                <span class="visually-hidden">{{ 'general.localization.current_language' | t: language: active_language_name }}</span>
                <span aria-hidden="true">{{- language.iso_code | upcase -}}</span>
              </span>
            {%- else -%}
              <button
                class="localization-form__item localization-form__btn"
                type="submit"
                name="language_code"
                value="{{ language.iso_code | escape }}"
                aria-label="{{ 'general.localization.update' | t }}: {{ language.endonym_name | capitalize | escape }}"
              >
                {{- language.iso_code | upcase -}}
              </button>
            {%- endif -%}
            {%- unless forloop.last -%}
              <span class="localization-form__divider" aria-hidden="true">/</span>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if show_country_selector -%}
        <div class="localization-form__country-wrapper">
          <label class="visually-hidden" for="{{ localization_form_id }}-country">{{ 'general.localization.country' | t }}</label>
          <select id="{{ localization_form_id }}-country" class="localization-form__country" name="country_code" data-localization-select>
            {%- for country in localization.available_countries -%}
              <option
                value="{{ country.iso_code }}"
                {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}
              >
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
          {%- comment -%} Sin JS el cambio de pais no tiene como enviarse: este boton solo se ve en .no-js (6A-001). {%- endcomment -%}
          <button type="submit" class="button button--secondary localization-form__country-submit no-js-only">
            {{- 'general.localization.update' | t -}}
          </button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </localization-form>
{%- endif -%}

{%- if show_editor_notice -%}
  <div class="localization-form__notice">
    {%- if language_needs_setup -%}
      <p>{{ 'general.localization.editor_notice_language' | t }}</p>
    {%- endif -%}
    {%- if country_needs_setup -%}
      <p>{{ 'general.localization.editor_notice_country' | t }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
