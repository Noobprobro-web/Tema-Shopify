{%- comment -%}
  Renders Shopify's native localization form.

  Accepts:
  - context: unique suffix for IDs when rendered more than once
{%- endcomment -%}

{%- liquid
  assign localization_context = context | default: 'default' | handle
  assign localization_form_id = 'LocalizationForm-' | append: localization_context
  assign show_country_selector = false
  assign show_language_selector = false

  if localization.available_countries.size > 1
    assign show_country_selector = true
  endif

  if localization.available_languages.size > 1
    assign show_language_selector = true
  endif
-%}

{%- if show_country_selector or show_language_selector -%}
  <localization-form class="localization-form" data-localization-form>
    {%- form 'localization', id: localization_form_id, class: 'localization-form__form' -%}
      {%- if show_country_selector -%}
        <div class="localization-form__field">
          <label for="CountrySelector-{{ localization_context }}">
            {{- 'general.localization.country' | t -}}
          </label>
          <select
            id="CountrySelector-{{ localization_context }}"
            name="country_code"
            data-localization-select
          >
            {%- for country in localization.available_countries -%}
              <option
                value="{{ country.iso_code | escape }}"
                {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
              >
                {{- country.name | escape -}}
                {{- ' · ' -}}
                {{- country.currency.iso_code | escape -}}
                {{- ' ' -}}
                {{- country.currency.symbol | escape -}}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

      {%- if show_language_selector -%}
        <div class="localization-form__field">
          <label for="LanguageSelector-{{ localization_context }}">
            {{- 'general.localization.language' | t -}}
          </label>
          <select
            id="LanguageSelector-{{ localization_context }}"
            name="language_code"
            data-localization-select
          >
            {%- for language in localization.available_languages -%}
              <option
                value="{{ language.iso_code | escape }}"
                lang="{{ language.iso_code | escape }}"
                {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
              >
                {{- language.endonym_name | capitalize | escape -}}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

      <button class="button button--secondary no-js-only" type="submit">
        {{- 'general.localization.update' | t -}}
      </button>
    {%- endform -%}
  </localization-form>
{%- endif -%}
