{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": { "type": "vendor", "settings": {} },
        "title": { "type": "title", "settings": {} },
        "price": { "type": "price", "settings": {} },
        "options": { "type": "variant_picker", "settings": {} },
        "quantity": { "type": "quantity", "settings": {} },
        "buy": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true } },
        "description": { "type": "description", "settings": {} }
      },
      "block_order": ["vendor", "title", "price", "options", "quantity", "buy", "description"],
      "settings": {
        "color_scheme": "scheme-1",
        "media_layout": "grid",
        "enable_sticky_cart": true
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "color_scheme": "scheme-3",
        "intent": "related",
        "eyebrow": "RELATED OBJECTS",
        "products_to_show": 4,
        "columns_desktop": "4",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_quick_add": true
      }
    }
  },
  "order": ["main", "recommendations"]
}
