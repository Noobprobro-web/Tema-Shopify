{
  "name": "shopify-theme-project",
  "version": "0.1.0",
  "private": true,
  "description": "Base colaborativa para un tema Shopify original, minimalista y apto para revision futura.",
  "scripts": {
    "shopify:version": "shopify version",
    "theme:check": "shopify theme check",
    "theme:dev": "shopify theme dev",
    "theme:package": "shopify theme package",
    "gates:sanity": "node scripts/theme-check-sanity.mjs",
    "gates:locales": "node scripts/locale-key-inventory.mjs",
    "gates:ledger": "node scripts/ledger-verify.mjs",
    "gates:theme-check": "shopify theme check",
    "gates:syntax": "node --check assets/theme.js && node --check assets/product-zoom.js",
    "gates:package": "shopify theme package",
    "gates:static": "npm run gates:json && npm run gates:hooks && npm run gates:sanity && npm run gates:locales && npm run gates:ledger && npm run gates:theme-check && npm run gates:syntax && npm run gates:package",
    "test:visual": "playwright test",
    "gates:json": "node scripts/json-validate.mjs",
    "gates:hooks": "node scripts/dataset-hooks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@shopify/cli": "^4.8.0"
  }
}
