{% layout none %}

{%- liquid
  assign initial_value = gift_card.initial_value | money
  assign balance = gift_card.balance | money
  assign default_scheme = settings.default_color_scheme
  assign logo_alt = settings.logo.alt | default: shop.name
  if gift_card.expires_on
    assign formatted_expires_on = gift_card.expires_on | date: '%B %d, %Y'
  endif
-%}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ 'gift_cards.issued.title' | t: value: initial_value, shop: shop.name | escape_once }}</title>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}

      :root {
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --font-heading-style: {{ settings.type_heading_font.style }};
        --font-heading-weight: {{ settings.type_heading_font.weight }};
        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --button-radius: {{ settings.button_radius }}px;
        --color-background: {{ default_scheme.settings.background | default: '#F7F3EA' }};
        --gradient-background: {% if default_scheme.settings.background_gradient != blank %}{{ default_scheme.settings.background_gradient }}{% else %}{{ default_scheme.settings.background | default: '#F7F3EA' }}{% endif %};
        --color-foreground: {{ default_scheme.settings.text | default: '#1D1B18' }};
        --color-button: {{ default_scheme.settings.button | default: '#1D1B18' }};
        --color-button-label: {{ default_scheme.settings.button_label | default: '#FFFFFF' }};
        --color-link: {{ default_scheme.settings.secondary_button_label | default: '#1D1B18' }};
        --color-border: {{ default_scheme.settings.border | default: '#CAC2B5' }};
        --color-shadow: {{ default_scheme.settings.shadow | default: '#1D1B18' }};
      }
    {% endstyle %}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    {{ content_for_header }}
  </head>

  <body>
    <main class="gift-card-page">
      <article class="gift-card flow" aria-labelledby="GiftCardTitle">
        <a class="gift-card__brand" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            {{-
              settings.logo
              | image_url: width: 360
              | image_tag:
                class: 'gift-card__logo',
                widths: '120, 180, 240, 360',
                width: settings.logo_width,
                alt: logo_alt
            -}}
          {%- else -%}
            <span class="h3">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>

        <div>
          <p class="eyebrow">{{ 'gift_cards.issued.gift_card' | t }}</p>
          <h1 id="GiftCardTitle">{{ shop.name | escape }}</h1>
          <p class="gift-card__value">{{ initial_value }}</p>
          <p>{{ 'gift_cards.issued.remaining_html' | t: balance: balance }}</p>
        </div>

        {%- unless gift_card.enabled -%}
          <p role="status">{{ 'gift_cards.issued.disabled' | t }}</p>
        {%- elsif gift_card.expired -%}
          <p role="status">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- endunless -%}

        {%- if gift_card.expires_on -%}
          <p>{{ 'gift_cards.issued.expires_on' | t: expires_on: formatted_expires_on }}</p>
        {%- endif -%}

        <div>
          <p>{{ 'gift_cards.issued.use_at_checkout' | t }}</p>
          <strong class="gift-card__code">{{ gift_card.code | format_code }}</strong>
        </div>

        <div
          id="GiftCardQrCode"
          class="gift-card__qr"
          role="img"
          aria-label="{{ 'gift_cards.issued.qr_code_alt' | t }}"
          data-identifier="{{ gift_card.qr_identifier | escape }}"
        ></div>

        <div class="gift-card__actions">
          <a class="button" href="{{ routes.root_url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
          <button class="button" type="button" data-gift-card-print>{{ 'gift_cards.issued.print' | t }}</button>
        </div>

        {%- if gift_card.pass_url -%}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
            >
          </a>
        {%- endif -%}
      </article>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        // AF-13 (AUDIT-FINAL-001): sin manejadores en línea, compatible con una CSP estricta.
        var printButton = document.querySelector('[data-gift-card-print]');
        if (printButton) {
          printButton.addEventListener('click', function () {
            window.print();
          });
        }

        var qrCodeElement = document.getElementById('GiftCardQrCode');
        if (!qrCodeElement || !qrCodeElement.dataset.identifier || typeof QRCode === 'undefined') return;

        new QRCode(qrCodeElement, {
          text: qrCodeElement.dataset.identifier,
          width: 160,
          height: 160
        });
      });
    </script>
  </body>
</html>
