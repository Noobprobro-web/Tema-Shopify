{%- assign product_models = product.media | where: 'media_type', 'model' -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction }}" data-animations="{{ settings.animations | default: 'subtle' }}" data-motion-style="{{ settings.motion_style | default: 'atelier' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.default_color_scheme.settings.background | default: '#F7F3EA' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {%- if page_title != blank -%}
        {{- page_title | escape -}}
        {%- if current_tags %} &ndash; {{ current_tags | join: ', ' | escape }}{% endif -%}
        {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
      {%- else -%}
        {{- shop.name | escape -}}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'social-meta-tags' %}

    {%- if request.page_type == 'product' and product_models.size > 0 -%}
      <link
        id="ModelViewerStyle"
        rel="stylesheet"
        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
        media="print"
        onload="this.media='all'"
      >
      <noscript>
        <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css">
      </noscript>
    {%- endif -%}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      assign heading_font_bold = settings.type_heading_font | font_modify: 'weight', 'bold'
      assign heading_font_italic = settings.type_heading_font | font_modify: 'style', 'italic'
      assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'
      assign default_scheme_id = settings.default_color_scheme.id | default: settings.default_color_scheme | default: 'scheme-1'
    -%}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
      {{ heading_font_bold | font_face: font_display: 'swap' }}
      {{ heading_font_italic | font_face: font_display: 'swap' }}
      {{ heading_font_bold_italic | font_face: font_display: 'swap' }}

      :root {
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --font-heading-style: {{ settings.type_heading_font.style }};
        --font-heading-weight: {{ settings.type_heading_font.weight }};
        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --page-width: {{ settings.page_width }}px;
        --page-gutter: {{ settings.page_gutter }}px;
        --section-spacing: {{ settings.section_spacing }}px;
        --button-radius: {{ settings.button_radius }}px;
      }

      {%- for scheme in settings.color_schemes -%}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background }};
          --gradient-background: {% if scheme.settings.background_gradient != blank %}{{ scheme.settings.background_gradient }}{% else %}{{ scheme.settings.background }}{% endif %};
          --color-foreground: {{ scheme.settings.text }};
          --color-button: {{ scheme.settings.button }};
          --color-button-label: {{ scheme.settings.button_label }};
          --color-link: {{ scheme.settings.secondary_button_label }};
          --color-border: {{ scheme.settings.border }};
          --color-shadow: {{ scheme.settings.shadow }};
        }
      {%- endfor -%}
    {% endstyle %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      window.theme = window.theme || {};
      window.theme.moneyFormat = {{ shop.money_format | strip_html | json }};
      document.documentElement.dataset.moneyFormat = window.theme.moneyFormat;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.reducedMotion = 'true';
      }
    </script>

    {% render 'structured-data' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }} color-{{ default_scheme_id }}{% if request.design_mode %} theme-editor{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="site-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if request.page_type == 'product' and product_models.size > 0 -%}
      <script src="{{ 'shopify-xr.js' | shopify_asset_url }}" defer></script>
      <script>
        (() => {
          const setupShopifyXR = () => {
            if (!window.ShopifyXR) {
              document.addEventListener('shopify_xr_initialized', setupShopifyXR, { once: true });
              return;
            }

            document.querySelectorAll('[id^="ProductModelJSON-"]').forEach((modelJSON) => {
              window.ShopifyXR.addModels(JSON.parse(modelJSON.textContent));
            });
            window.ShopifyXR.setupXRElements();
          };

          const setupModelViewerUI = (errors) => {
            if (errors || !window.Shopify?.ModelViewerUI) return;
            document.querySelectorAll('model-viewer').forEach((modelViewer) => {
              if (modelViewer.dataset.themeModelViewerReady === 'true') return;
              new window.Shopify.ModelViewerUI(modelViewer);
              modelViewer.dataset.themeModelViewerReady = 'true';
            });
          };

          setupShopifyXR();
          window.Shopify?.loadFeatures?.([
            { name: 'model-viewer-ui', version: '1.0', onLoad: setupModelViewerUI },
          ]);
        })();
      </script>
    {%- endif -%}
  </body>
</html>
